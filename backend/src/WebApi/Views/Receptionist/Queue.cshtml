@{
    ViewData["Title"] = "Lễ Tân - Digital Whiteboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* Modern Digital Whiteboard Styles */
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #f0f2f5;
        }
        
        .kanban-board {
            display: flex;
            gap: 1.5rem;
            align-items: flex-start;
            overflow-x: auto;
            padding-bottom: 1rem;
        }

        .kanban-wrapper {
            flex: 1;
            min-width: 320px;
        }

        .kanban-column {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 1.2rem;
            padding: 1.25rem;
            box-shadow: 0 8px 32px rgba(31, 38, 135, 0.05);
            min-height: 70vh;
            display: flex;
            flex-direction: column;
        }

        .kanban-column[data-status="waiting"] { border-top: 5px solid #6c757d; }
        .kanban-column[data-status="in_progress"] { border-top: 5px solid #ffb020; }
        .kanban-column[data-status="ready_to_pay"] { border-top: 5px solid #14b8a6; }

        .kanban-list {
            flex-grow: 1;
            min-height: 100px;
        }

        .kanban-card {
            background: #ffffff;
            border-radius: 1rem;
            border: 1px solid #edf2f7;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            margin-bottom: 1rem;
            position: relative;
            overflow: hidden;
        }
        
        /* SLA Warning Border */
        .kanban-card.sla-warning {
            border: 2px solid #f59e0b;
            box-shadow: 0 0 15px rgba(245, 158, 11, 0.3);
            animation: pulse-orange 2s infinite;
        }

        .kanban-card.sla-danger {
            border: 2px solid #ef4444;
            box-shadow: 0 0 15px rgba(239, 68, 68, 0.3);
            animation: pulse-red 1.5s infinite;
        }

        @@keyframes pulse-orange {
            0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(245, 158, 11, 0); }
            100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
        }

        @@keyframes pulse-red {
            0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }

        .kanban-card:hover {
            transform: translateY(-4px) scale(1.01);
            box-shadow: 0 12px 20px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            border-color: #cbd5e1;
        }

        .filter-bar {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            border-radius: 1rem;
            padding: 1rem 1.5rem;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            border: 1px solid rgba(255,255,255,0.9);
        }
        
        .quick-note-box {
            background: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 0.5rem;
            padding: 0.5rem;
            font-size: 0.85rem;
            color: #b45309;
            cursor: pointer;
            transition: all 0.2s;
        }
        .quick-note-box:hover {
            background: #fef3c7;
        }
    </style>
}

<!-- Omni Search Bar -->
<div class="row mb-4 position-relative z-3">
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-4" style="background: linear-gradient(135deg, #fdfaf0, #ffffff);">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="flex-grow-1 position-relative">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white border-end-0 rounded-start-4 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="omniSearchInput" class="form-control border-start-0 rounded-end-4 shadow-none" placeholder="Tìm kiếm nhanh Khách hàng, Số điện thoại, Mã Microchip hoặc Tên thú cưng..." autocomplete="off">
                    </div>
                    <!-- Dropdown Results -->
                    <div id="omniSearchResults" class="position-absolute w-100 bg-white shadow-lg rounded-4 mt-2 d-none" style="max-height: 400px; overflow-y: auto; z-index: 1050; border: 1px solid #eee;">
                        <!-- Results will be injected here via JS -->
                    </div>
                </div>
                <button class="btn btn-success btn-lg rounded-4 fw-bold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#qrScanModal">
                    <i class="bi bi-qr-code-scan me-2"></i> Quét mã QR
                </button>
                <button class="btn btn-danger btn-lg rounded-4 fw-bold px-4 shadow-sm" id="btnOpenEmergency">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> CẤP CỨU
                </button>
                <button class="btn btn-primary btn-lg rounded-4 fw-bold px-4 shadow-sm" id="btnOpenWalkIn">
                    <i class="bi bi-person-walking me-2"></i> Khách Vãng Lai
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="row mb-4 position-relative z-2">
    <div class="col-12">
        <div class="filter-bar d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark" style="font-family: 'Outfit', sans-serif;"><i class="bi bi-display me-2 text-primary"></i> Digital Whiteboard</h5>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small fw-bold">Bộ lọc Bác sĩ:</span>
                <select class="form-select border-primary rounded-pill shadow-sm" id="boardDoctorFilter" style="width: 250px;">
                    <option value="ALL">Tất cả Bác sĩ</option>
                    <!-- Options loaded via JS -->
                </select>
                <button class="btn btn-light rounded-pill btn-sm border shadow-sm" onclick="loadQueue()" title="Làm mới bảng">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Kanban Board -->
<div class="kanban-board">
    <!-- Cột 1: Waiting -->
    <div class="kanban-wrapper">
        <div class="kanban-column" data-status="waiting">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-secondary mb-0 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-hourglass-split me-2"></i> Đang chờ</h6>
                <span class="badge bg-secondary rounded-pill shadow-sm px-3" id="count-waiting">0</span>
            </div>
            <div id="kanban-waiting" class="kanban-list" data-status="waiting">
                <!-- Cards here -->
            </div>
        </div>
    </div>

    <!-- Cột 2: In Progress -->
    <div class="kanban-wrapper">
        <div class="kanban-column" data-status="in_progress">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-warning mb-0 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-activity me-2"></i> Đang khám</h6>
                <span class="badge bg-warning text-dark rounded-pill shadow-sm px-3" id="count-in_progress">0</span>
            </div>
            <div id="kanban-in_progress" class="kanban-list" data-status="in_progress">
                <!-- Cards here -->
            </div>
        </div>
    </div>

    <!-- Cột 3: Ready To Pay -->
    <div class="kanban-wrapper">
        <div class="kanban-column" data-status="ready_to_pay">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-success mb-0 text-uppercase" style="letter-spacing: 1px;"><i class="bi bi-cash-coin me-2"></i> Chờ thanh toán</h6>
                <span class="badge bg-success rounded-pill shadow-sm px-3" id="count-ready_to_pay">0</span>
            </div>
            <div id="kanban-ready_to_pay" class="kanban-list" data-status="ready_to_pay">
                <!-- Cards here -->
            </div>
        </div>
    </div>
</div>

<!-- Walk-in Modal -->
<div class="modal fade" id="walkInModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header text-white rounded-top-4 border-0" id="walkInModalHeader">
                <h5 class="modal-title fw-bold" id="walkInModalTitle"><i class="bi bi-person-walking me-2 text-warning"></i> Tạo ca Khách vãng lai</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="walkInForm">
                    <div class="row g-4">
                        <!-- Cột Thông tin Khách hàng -->
                        <div class="col-md-6 border-end pe-4">
                            <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">1. Thông tin Khách hàng</h6>
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold">Số điện thoại *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                    <input type="text" class="form-control" name="Phone" id="walkInPhone" required placeholder="Nhập SĐT để tự nhận diện...">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold">Họ và tên *</label>
                                <input type="text" class="form-control" name="FullName" id="walkInFullName" required>
                                <div id="walkInCustomerStatus" class="form-text text-success d-none"><i class="bi bi-check-circle-fill"></i> Đã tìm thấy khách hàng cũ</div>
                            </div>
                        </div>

                        <!-- Cột Thông tin Thú cưng & Ca khám -->
                        <div class="col-md-6 ps-4">
                            <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">2. Bệnh nhi & Dịch vụ</h6>
                            <div class="row mb-3">
                                <div class="col-7">
                                    <label class="form-label text-muted small fw-bold">Thú cưng *</label>
                                    <div id="petInputWrapper">
                                        <input type="text" class="form-control" name="PetName" id="walkInPetName" required placeholder="Nhập tên bé...">
                                    </div>
                                    <a href="javascript:void(0)" id="btnToggleNewPet" class="small text-decoration-none d-none mt-1"><i class="bi bi-plus-circle"></i> Bé này là thú cưng mới</a>
                                </div>
                                <div class="col-5">
                                    <label class="form-label text-muted small fw-bold">Loài</label>
                                    <select class="form-select" name="Species" id="walkInSpecies">
                                        <option value="Chó">Chó</option>
                                        <option value="Mèo">Mèo</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold">Bác sĩ chỉ định *</label>
                                <select class="form-select" name="DoctorId" id="doctorSelect" required>
                                    <!-- Sẽ load qua JS -->
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold">Triệu chứng ban đầu</label>
                                <textarea class="form-control" name="Symptom" rows="2" placeholder="VD: Bỏ ăn, nôn mửa..."></textarea>
                            </div>

                            <div class="form-check form-switch mt-3 d-none">
                                <input class="form-check-input" type="checkbox" role="switch" name="IsEmergency" id="flexSwitchEmergency" value="true">
                                <label class="form-check-label text-danger fw-bold" for="flexSwitchEmergency">
                                    Đánh dấu Cấp cứu (Ưu tiên khám ngay!)
                                </label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 bg-light rounded-bottom-4 p-3">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm" id="btnSubmitWalkIn">Tạo Ca Khám</button>
            </div>
        </div>
    </div>
</div>

<!-- Triage Emergency Modal -->
<div class="modal fade" id="emergencyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-danger text-white rounded-top-4 border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-heart-pulse-fill text-warning me-2"></i> BẢNG ĐÁNH GIÁ TRIAGE (CẤP CỨU)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <!-- Red Flags (Level 1) -->
                <div class="mb-4">
                    <h6 class="fw-bold text-danger mb-3"><span class="badge bg-danger me-2">MỨC 1 - NGUY KỊCH</span> Chọn nếu đe dọa tính mạng (Bỏ qua thủ tục, đẩy vào ngay!)</h6>
                    <div class="d-flex flex-wrap gap-2 triage-group" data-level="1">
                        <button type="button" class="btn btn-outline-danger btn-triage rounded-pill fw-bold" data-symptom="Khó thở / Tím tái">Khó thở / Tím tái</button>
                        <button type="button" class="btn btn-outline-danger btn-triage rounded-pill fw-bold" data-symptom="Co giật liên tục">Co giật liên tục</button>
                        <button type="button" class="btn btn-outline-danger btn-triage rounded-pill fw-bold" data-symptom="Mất máu ồ ạt">Mất máu ồ ạt</button>
                        <button type="button" class="btn btn-outline-danger btn-triage rounded-pill fw-bold" data-symptom="Sốc / Bất tỉnh">Sốc / Bất tỉnh</button>
                    </div>
                </div>

                <!-- Urgent (Level 2) -->
                <div class="mb-4">
                    <h6 class="fw-bold text-warning-emphasis mb-3"><span class="badge bg-warning text-dark me-2">MỨC 2 - CẤP BÁCH</span> Cần can thiệp sớm (Chỉ cần 1 SĐT để lưu tạm)</h6>
                    <div class="d-flex flex-wrap gap-2 triage-group" data-level="2">
                        <button type="button" class="btn btn-outline-warning text-dark btn-triage rounded-pill fw-bold" data-symptom="Gãy xương / Đa chấn thương">Gãy xương / Đa chấn thương</button>
                        <button type="button" class="btn btn-outline-warning text-dark btn-triage rounded-pill fw-bold" data-symptom="Nôn mửa / Tiêu chảy cấp">Nôn mửa / Tiêu chảy cấp</button>
                        <button type="button" class="btn btn-outline-warning text-dark btn-triage rounded-pill fw-bold" data-symptom="Nuốt dị vật">Nuốt dị vật</button>
                        <button type="button" class="btn btn-outline-warning text-dark btn-triage rounded-pill fw-bold" data-symptom="Ngộ độc">Ngộ độc</button>
                    </div>
                </div>

                <!-- Dynamic Form (Hiện ẩn theo Level) -->
                <div class="card border-0 shadow-sm rounded-4 mt-4 d-none" id="triageFormContainer">
                    <div class="card-body p-3">
                        <input type="hidden" id="triageLevel" value="0">
                        <input type="hidden" id="triageSymptom" value="">
                        
                        <div id="triagePhoneSection" class="mb-3 d-none">
                            <label class="form-label text-muted small fw-bold">Số điện thoại liên hệ nhanh (Bắt buộc cho Mức 2) *</label>
                            <input type="text" class="form-control border-warning" id="emergencyPhone" placeholder="Nhập SĐT để gọi trả thú cưng...">
                        </div>

                        <div class="mb-2">
                            <label class="form-label text-muted small fw-bold">Bác sĩ phụ trách (Không bắt buộc)</label>
                            <select class="form-select border-primary" id="emergencyDoctorSelect">
                                <option value="">-- Tự động phân công bác sĩ --</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="mt-4 text-center text-muted small">
                    <i>* Lưu ý: Nếu ca bệnh nhẹ (Mức 3 - Ổn định), vui lòng đóng bảng này và chọn tính năng "Khách Vãng Lai".</i>
                </div>
            </div>
            <div class="modal-footer border-0 bg-white rounded-bottom-4 p-3 d-flex justify-content-between">
                <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-secondary rounded-pill px-5 fw-bold shadow-sm" id="btnSubmitEmergency" disabled>Vui lòng chọn triệu chứng</button>
            </div>
        </div>
    </div>
</div>

<!-- QR Scan Modal -->
<div class="modal fade" id="qrScanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-success text-white rounded-top-4 border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-qr-code-scan me-2"></i> Quét Mã Lịch Hẹn</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <p class="text-muted small mb-3">Đưa mã QR của khách hàng vào trước Camera để tự động Check-in.</p>
                <!-- Nơi hiển thị Camera -->
                <div id="qr-reader" style="width: 100%; border-radius: 1rem; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1);"></div>
                <div id="qr-result-msg" class="mt-3 fw-bold text-success d-none"></div>
            </div>
            <div class="modal-footer border-0 bg-light rounded-bottom-4 p-3">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng Camera</button>
            </div>
        </div>
    </div>
</div>

<!-- Update Customer Modal -->
<div class="modal fade" id="updateCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-primary text-white rounded-top-4 border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill me-2"></i> Cập nhật Thông tin Chủ nuôi</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-3">Nhập số điện thoại của chủ nuôi để ghép nối ca cấp cứu này với hồ sơ khách hàng thật.</p>
                
                <input type="hidden" id="updateCustAppointmentId">
                
                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold">Số điện thoại *</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                        <input type="text" class="form-control" id="updateCustPhone" required placeholder="Nhập SĐT khách hàng...">
                    </div>
                </div>

                <div id="updateCustResult" class="d-none">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Khách hàng</label>
                        <input type="text" class="form-control bg-light" id="updateCustName" readonly>
                        <input type="hidden" id="updateCustId">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Chọn thú cưng *</label>
                        <select class="form-select border-primary" id="updateCustPetSelect" required>
                            <!-- Options rendered by JS -->
                        </select>
                    </div>
                </div>

                <div id="updateCustNotFound" class="d-none alert alert-warning small">
                    Không tìm thấy số điện thoại này trong hệ thống. Vui lòng tạo hồ sơ mới cho khách ở trang "Khách hàng" trước!
                </div>
            </div>
            <div class="modal-footer border-0 bg-light rounded-bottom-4 p-3">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm d-none" id="btnSubmitUpdateCust">Cập nhật hồ sơ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Thư viện Kéo Thả (SortableJS) -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <!-- SweetAlert2 cho thông báo mượt mà -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Thư viện HTML5 QRCode -->
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

    <script>
        $(document).ready(function () {
            
            // XÓA BỎ SORTABLE JS Ở ĐÂY VÌ ĐÃ CHUYỂN SANG KIẾN TRÚC TỰ ĐỘNG HÓA
            // Bảng bây giờ chỉ có vai trò Read-only (Radar) hiển thị luồng bệnh nhân
            // Thẻ sẽ tự động nhảy khi Bác sĩ thao tác trên Dashboard của họ.

            // Load danh sách Bác sĩ cho Filter
            $.get('/Receptionist/GetDoctors', function(docs) {
                docs.forEach(d => {
                    $('#boardDoctorFilter').append(`<option value="${d.id}">Bs. ${d.fullName}</option>`);
                });
            });

            $('#boardDoctorFilter').change(function() {
                loadQueue();
            });

            // SLA Timer Checker (chạy mỗi 30s)
            setInterval(checkSLA, 30000);

            function checkSLA() {
                const now = new Date();
                $('.kanban-card[data-status="waiting"]').each(function() {
                    const checkInRaw = $(this).attr('data-time');
                    if (!checkInRaw) return;
                    
                    const checkInTime = new Date(checkInRaw);
                    const diffMins = Math.floor((now - checkInTime) / 60000);
                    
                    $(this).removeClass('sla-warning sla-danger');
                    $(this).find('.sla-text').remove();

                    if (diffMins >= 30) {
                        $(this).addClass('sla-danger');
                        $(this).find('.card-body').prepend(`<div class="sla-text text-danger small fw-bold mb-1"><i class="bi bi-alarm-fill"></i> Chờ quá lâu (${diffMins} phút)</div>`);
                    } else if (diffMins >= 15) {
                        $(this).addClass('sla-warning');
                        $(this).find('.card-body').prepend(`<div class="sla-text text-warning small fw-bold mb-1"><i class="bi bi-alarm"></i> Đang chờ (${diffMins} phút)</div>`);
                    }
                });
            }

            // Hàm Load danh sách Queue ban đầu
            function loadQueue() {
                $.get('/Receptionist/GetTodayQueue', function (data) {
                    const filterDoc = $('#boardDoctorFilter').val();
                    
                    if (filterDoc && filterDoc !== 'ALL') {
                        data = data.filter(x => x.doctorId === filterDoc);
                    }

                    // Xóa rỗng các cột
                    $('.kanban-list').empty();
                    
                    let counts = { waiting: 0, in_progress: 0, ready_to_pay: 0 };

                    data.forEach(item => {
                        counts[item.status]++;
                        
                        const emergencyBadge = item.isEmergency 
                            ? `<span class="badge bg-danger mb-2"><i class="bi bi-exclamation-triangle-fill"></i> CẤP CỨU</span>` : '';
                        
                        const aggressiveBadge = item.isAggressive 
                            ? `<span class="badge bg-dark mb-2 ms-1"><i class="bi bi-shield-slash-fill"></i> HUNG DỮ</span>` : '';
                            
                        const timeStr = item.checkInTime ? new Date(item.checkInTime).toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'}) : '';

                        let updateCustomerBtn = '';
                        if (item.customerName === 'Khách Cấp Cứu') {
                            updateCustomerBtn = `
                                <button class="btn btn-sm btn-outline-primary w-100 mt-2 rounded-pill fw-bold" onclick="openUpdateCustomerModal(${item.appointmentId})">
                                    <i class="bi bi-person-plus-fill"></i> Cập nhật chủ nuôi
                                </button>
                            `;
                        }
                        
                        let quickNote = '';
                        if (item.status === 'in_progress') {
                            quickNote = `
                                <div class="quick-note-box mt-2" onclick="editNote(${item.appointmentId})">
                                    <i class="bi bi-pencil-square"></i> ${item.symptom || 'Thêm ghi chú y lệnh...'}
                                </div>
                            `;
                        }

                        const checkInIso = item.checkInTime ? new Date(item.checkInTime).toISOString() : '';

                        const cardHtml = `
                            <div class="card kanban-card shadow-sm border-0 rounded-4" data-id="${item.appointmentId}" data-status="${item.status}" data-time="${checkInIso}">
                                <div class="card-body p-3">
                                    ${emergencyBadge} ${aggressiveBadge}
                                    <div class="d-flex justify-content-between align-items-start mb-2 mt-1">
                                        <h6 class="card-title fw-bold text-dark mb-0" style="font-size: 1.1rem;">${item.petName || 'Không tên'} <span class="text-muted small fw-normal">(${item.species || 'Pet'})</span></h6>
                                        <span class="badge bg-light text-secondary border border-secondary rounded-pill">#${item.queueNumber}</span>
                                    </div>
                                    <p class="card-text text-muted small mb-2"><i class="bi bi-person-circle me-1 text-primary"></i> ${item.customerName || 'Vãng lai'}</p>
                                    ${quickNote}
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                        <div class="small text-muted"><i class="bi bi-clock me-1"></i> ${timeStr}</div>
                                        <div class="small fw-bold text-primary bg-primary bg-opacity-10 px-2 py-1 rounded-pill" title="Bác sĩ phụ trách">
                                            <i class="bi bi-heart-pulse-fill me-1"></i> Bs. ${item.doctorName?.split(' ').pop() || 'N/A'}
                                        </div>
                                    </div>
                                    ${updateCustomerBtn}
                                </div>
                            </div>
                        `;
                        
                        $(`#kanban-${item.status}`).append(cardHtml);
                    });

                    // Cập nhật số lượng
                    $('#count-waiting').text(counts.waiting);
                    $('#count-in_progress').text(counts.in_progress);
                    $('#count-ready_to_pay').text(counts.ready_to_pay);
                    
                    // Chạy check SLA ngay khi load xong
                    checkSLA();
                });
            }

            window.editNote = function(id) {
                // Feature placeholder cho Quick Note (Bác sĩ click vào sẽ sửa dc)
                Swal.fire({
                    title: 'Ghi chú nhanh',
                    input: 'text',
                    inputPlaceholder: 'Nhập trạng thái (VD: Đang truyền dịch...)',
                    showCancelButton: true,
                    confirmButtonText: 'Lưu',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Tạm thời hiển thị toast, chưa update DB vì cần thêm API UpdateSymptom
                        Swal.fire('Đã lưu!', 'Ghi chú đã được cập nhật.', 'success');
                        loadQueue(); // Tạm reload
                    }
                });
            };

            // Radar Auto-Refresh: Tự động tải lại bảng mỗi 10 giây (Polling)
            setInterval(function() {
                loadQueue();
            }, 10000);

            // Khởi chạy load ban đầu
            loadQueue();
            // Có thể dùng setInterval(loadQueue, 15000); để polling realtime nếu ko dùng SignalR

            // 2. Logic OmniSearch
            let searchTimeout;
            $('#omniSearchInput').on('input', function() {
                const query = $(this).val();
                clearTimeout(searchTimeout);
                
                if (query.length < 2) {
                    $('#omniSearchResults').addClass('d-none').empty();
                    return;
                }

                searchTimeout = setTimeout(function() {
                    $.get('/Receptionist/OmniSearch', { q: query }, function(data) {
                        const resultsBox = $('#omniSearchResults');
                        resultsBox.empty();

                        if (data.length === 0) {
                            resultsBox.append('<div class="p-3 text-center text-muted">Không tìm thấy kết quả nào.</div>');
                        } else {
                            data.forEach(user => {
                                let petsHtml = '';
                                user.pets.forEach(pet => {
                                    petsHtml += `
                                        <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded mt-2">
                                            <div><i class="bi bi-box2-heart text-danger me-2"></i><strong>${pet.name}</strong> (${pet.species})</div>
                                            <button class="btn btn-sm btn-outline-success rounded-pill px-3 btn-checkin" 
                                                data-phone="${user.phone}" 
                                                data-name="${user.fullName}" 
                                                data-pet="${pet.name}" 
                                                data-species="${pet.species}">Check-in ngay</button>
                                        </div>
                                    `;
                                });

                                const userHtml = `
                                    <div class="p-3 border-bottom search-result-item">
                                        <div class="d-flex justify-content-between">
                                            <div class="fw-bold text-dark"><i class="bi bi-person-circle me-2 text-primary"></i> ${user.fullName}</div>
                                            <div class="text-muted small"><i class="bi bi-telephone me-1"></i> ${user.phone}</div>
                                        </div>
                                        <div class="ps-4 mt-1">
                                            ${petsHtml}
                                        </div>
                                    </div>
                                `;
                                resultsBox.append(userHtml);
                            });
                        }
                        resultsBox.removeClass('d-none');
                    });
                }, 400); // Debounce 400ms
            });

            // Ẩn kết quả tìm kiếm khi click ngoài
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#omniSearchInput, #omniSearchResults').length) {
                    $('#omniSearchResults').addClass('d-none');
                }
            });

            // 3. Logic Form Walk-in
            // Load Doctors for dropdown 
            $.get('/Receptionist/GetDoctors', function(res) {
                 const select = $('#doctorSelect');
                 select.empty();
                 if(res.length === 0) {
                     select.append('<option value="">-- Không có bác sĩ --</option>');
                 } else {
                     res.forEach(doc => {
                         select.append(`<option value="${doc.id}">Bs. ${doc.fullName}</option>`);
                     });
                 }
            }).fail(function() {
                 $('#doctorSelect').html('<option value="">Lỗi tải danh sách bác sĩ</option>');
            });

            $('#btnSubmitWalkIn').click(function() {
                const formData = $('#walkInForm').serializeArray();
                const dataObj = {};
                formData.forEach(item => dataObj[item.name] = item.value);
                
                // Set default ServiceId for now since WalkIn is generic emergency
                dataObj.ServiceId = 1; 

                // Nếu IsEmergency ko có trong dataObj (khi checkbox ko check)
                if(!$('#flexSwitchEmergency').is(':checked')) {
                    dataObj.IsEmergency = false;
                }

                $.ajax({
                    url: '/Receptionist/CreateWalkIn',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dataObj),
                    success: function(res) {
                        if (res.success) {
                            $('#walkInModal').modal('hide');
                            resetWalkInForm();
                            Swal.fire('Thành công', 'Đã xếp vào hàng đợi!', 'success');
                            loadQueue(); // Tải lại bảng
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    }
                });
            });

            // Gắn sự kiện Check-in từ OmniSearch
            $(document).on('click', '.btn-checkin', function() {
                $('#omniSearchResults').addClass('d-none');
                
                const phone = $(this).data('phone');
                const name = $(this).data('name');
                const petName = $(this).data('pet');
                const species = $(this).data('species');
                
                // Mở Modal và fill data
                $('#walkInPhone').val(phone).trigger('blur'); 
                
                // Đợi 1 chút cho blur API chạy xong rồi set giá trị pet
                setTimeout(() => {
                    $('#walkInModal').modal('show');
                    if ($('#walkInPetSelect').length) {
                        $('#walkInPetSelect').val(petName);
                    } else {
                        $('#walkInPetName').val(petName);
                    }
                    $('#walkInSpecies').val(species);
                }, 300);
            });
            
            // --- AUTO FILL LOGIC ---
            $('#walkInPhone').on('blur', function() {
                const phone = $(this).val().trim();
                if (phone.length < 9) return;
                
                $.get('/Receptionist/GetCustomerByPhone', { phone: phone }, function(res) {
                    if(res.success) {
                        $('#walkInFullName').val(res.customer.fullName).prop('readonly', true).addClass('bg-light');
                        $('#walkInCustomerStatus').removeClass('d-none');
                        
                        // Thay đổi ô nhập Pet thành dropdown
                        if(res.pets && res.pets.length > 0) {
                            let options = res.pets.map(p => `<option value="${p.name}" data-species="${p.species}">${p.name} (${p.species})</option>`).join('');
                            $('#petInputWrapper').html(`
                                <select class="form-select border-success" name="PetName" id="walkInPetSelect">
                                    ${options}
                                </select>
                            `);
                            $('#btnToggleNewPet').removeClass('d-none');
                            
                            // Tự động set Species theo pet chọn
                            $('#walkInPetSelect').change(function() {
                                $('#walkInSpecies').val($(this).find(':selected').data('species'));
                            }).trigger('change');
                        }
                    } else {
                        resetCustomerFields();
                    }
                });
            });
            
            $('#btnToggleNewPet').click(function() {
                $('#petInputWrapper').html('<input type="text" class="form-control border-primary" name="PetName" id="walkInPetName" required placeholder="Nhập tên bé...">');
                $(this).addClass('d-none');
            });
            
            function resetCustomerFields() {
                $('#walkInFullName').prop('readonly', false).removeClass('bg-light');
                $('#walkInCustomerStatus').addClass('d-none');
                $('#petInputWrapper').html('<input type="text" class="form-control" name="PetName" id="walkInPetName" required placeholder="Nhập tên bé...">');
                $('#btnToggleNewPet').addClass('d-none');
            }
            
            function resetWalkInForm() {
                $('#walkInForm')[0].reset();
                resetCustomerFields();
            }
            
            $('#walkInModal').on('hidden.bs.modal', function () {
                resetWalkInForm();
            });

            // Gắn sự kiện mở Modal riêng biệt
            $('#btnOpenWalkIn').click(function() {
                $('#walkInModalHeader').removeClass('bg-danger').addClass('bg-primary');
                $('#walkInModalTitle').html('<i class="bi bi-person-walking me-2 text-warning"></i> Tạo ca Khách vãng lai');
                $('#flexSwitchEmergency').prop('checked', false);
                $('#walkInModal').modal('show');
            });

            // Triage Logic
            $('.btn-triage').click(function() {
                // Đổi style button
                $('.btn-triage').removeClass('active text-white').addClass('text-dark');
                if ($(this).hasClass('btn-outline-danger')) {
                    $('.btn-triage').removeClass('active text-white');
                    $(this).removeClass('text-dark').addClass('active text-white');
                } else {
                    $('.btn-triage').removeClass('active text-white');
                    $(this).removeClass('text-dark').addClass('active text-white text-dark-hover');
                }
                
                const level = $(this).closest('.triage-group').data('level');
                const symptom = $(this).data('symptom');
                
                $('#triageLevel').val(level);
                $('#triageSymptom').val(symptom);
                
                $('#triageFormContainer').removeClass('d-none');
                $('#btnSubmitEmergency').prop('disabled', false).text('Đẩy Ca Khám Ngay!');
                
                if (level == 1) {
                    $('#triagePhoneSection').addClass('d-none');
                    $('#emergencyPhone').val('').prop('required', false);
                } else if (level == 2) {
                    $('#triagePhoneSection').removeClass('d-none');
                    $('#emergencyPhone').prop('required', true);
                }
            });

            // Mở Modal Cấp cứu
            $('#btnOpenEmergency').click(function () {
                const docSelect = $('#emergencyDoctorSelect');
                if (docSelect.children('option').length <= 1) {
                    $('#doctorSelect option').each(function() {
                        if ($(this).val() !== '') {
                            docSelect.append($(this).clone());
                        }
                    });
                }
                
                // Reset form
                $('.btn-triage').removeClass('active text-white text-dark').removeClass('text-dark-hover');
                $('#triageFormContainer').addClass('d-none');
                $('#triageLevel').val('0');
                $('#emergencyPhone').val('');
                $('#emergencyDoctorSelect').prop('selectedIndex', 0);
                $('#btnSubmitEmergency').prop('disabled', true).text('Vui lòng chọn triệu chứng');
                
                $('#emergencyModal').modal('show');
            });

            // Submit Cấp cứu
            $('#btnSubmitEmergency').click(function() {
                const level = $('#triageLevel').val();
                const symptom = $('#triageSymptom').val();
                const doctorId = $('#emergencyDoctorSelect').val() || null;
                let phone = "0000000000";
                
                if (level == 2) {
                    phone = $('#emergencyPhone').val().trim();
                    if (!phone) {
                        Swal.fire('Thiếu thông tin', 'Vui lòng nhập số điện thoại để liên hệ (Mức 2)!', 'warning');
                        return;
                    }
                }

                const dataObj = {
                    Phone: phone,
                    FullName: "Khách Cấp Cứu",
                    PetName: "Bệnh nhi Khẩn",
                    Species: "Khác",
                    DoctorId: doctorId,
                    ServiceId: 1, // Mặc định khám
                    Symptom: symptom,
                    IsEmergency: true
                };

                $('#btnSubmitEmergency').prop('disabled', true).text('Đang xử lý...');

                $.ajax({
                    url: '/Receptionist/CreateWalkIn',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dataObj),
                    success: function(res) {
                        if (res.success) {
                            $('#emergencyModal').modal('hide');
                            Swal.fire('BÁO ĐỘNG', 'Đã tiếp nhận ca cấp cứu thành công!', 'success');
                            loadQueue();
                        } else {
                            $('#btnSubmitEmergency').prop('disabled', false).text('Đẩy Ca Khám Ngay!');
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    },
                    error: function() {
                        $('#btnSubmitEmergency').prop('disabled', false).text('Đẩy Ca Khám Ngay!');
                        Swal.fire('Lỗi hệ thống', 'Không thể kết nối máy chủ.', 'error');
                    }
                });
            });

            // 4. Logic QR Code Scanner
            let html5QrcodeScanner = null;

            $('#qrScanModal').on('shown.bs.modal', function () {
                $('#qr-result-msg').addClass('d-none').text('');
                
                // Khởi tạo scanner
                html5QrcodeScanner = new Html5QrcodeScanner(
                    "qr-reader", 
                    { fps: 10, qrbox: {width: 250, height: 250}, aspectRatio: 1.0 }, 
                    /* verbose= */ false);
                    
                html5QrcodeScanner.render(onScanSuccess, onScanFailure);
            });

            $('#qrScanModal').on('hidden.bs.modal', function () {
                if (html5QrcodeScanner) {
                    html5QrcodeScanner.clear().catch(error => {
                        console.error("Failed to clear html5QrcodeScanner. ", error);
                    });
                    html5QrcodeScanner = null;
                }
            });

            function onScanSuccess(decodedText, decodedResult) {
                // Tạm dừng scan sau khi quét thành công
                if (html5QrcodeScanner) {
                    html5QrcodeScanner.clear();
                    html5QrcodeScanner = null;
                }
                
                const qrToken = decodedText.trim();
                $('#qr-result-msg').removeClass('d-none text-danger').addClass('text-success').text('Quét thành công! Đang xử lý Check-in...');

                // Gửi request CheckIn
                $.ajax({
                    url: '/Receptionist/CheckIn',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ 
                        QrToken: qrToken, 
                        IsEmergency: false 
                    }),
                    success: function(res) {
                        if (res.success) {
                            Swal.fire('Thành công', 'Đã Check-in ca khám từ mã QR!', 'success');
                            $('#qrScanModal').modal('hide');
                            loadQueue(); // Tải lại bảng Kanban
                        } else {
                            $('#qr-result-msg').removeClass('text-success').addClass('text-danger').text('Lỗi: ' + res.message);
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    },
                    error: function() {
                        $('#qr-result-msg').removeClass('text-success').addClass('text-danger').text('Lỗi kết nối máy chủ.');
                    }
                });
            }

            function onScanFailure(error) {
                // Ignore failure as it's continuous
            }

            // Cập nhật Customer cho ca Cấp Cứu Ẩn Danh
            window.openUpdateCustomerModal = function(appointmentId) {
                $('#updateCustAppointmentId').val(appointmentId);
                $('#updateCustPhone').val('');
                $('#updateCustResult').addClass('d-none');
                $('#updateCustNotFound').addClass('d-none');
                $('#btnSubmitUpdateCust').addClass('d-none');
                $('#updateCustomerModal').modal('show');
            };

            $('#updateCustPhone').on('blur', function() {
                const phone = $(this).val().trim();
                if (phone.length < 9) return;
                
                $.get('/Receptionist/GetCustomerByPhone', { phone: phone }, function(res) {
                    if(res.success) {
                        $('#updateCustNotFound').addClass('d-none');
                        $('#updateCustResult').removeClass('d-none');
                        
                        $('#updateCustName').val(res.customer.fullName);
                        $('#updateCustId').val(res.customer.id);
                        
                        const petSelect = $('#updateCustPetSelect');
                        petSelect.empty();
                        if(res.pets && res.pets.length > 0) {
                            res.pets.forEach(p => {
                                petSelect.append(`<option value="${p.id}">${p.name} (${p.species})</option>`);
                            });
                            $('#btnSubmitUpdateCust').removeClass('d-none');
                        } else {
                            petSelect.append(`<option value="">Khách chưa có thú cưng!</option>`);
                            $('#btnSubmitUpdateCust').addClass('d-none');
                        }
                    } else {
                        $('#updateCustResult').addClass('d-none');
                        $('#updateCustNotFound').removeClass('d-none');
                        $('#btnSubmitUpdateCust').addClass('d-none');
                    }
                });
            });

            $('#btnSubmitUpdateCust').click(function() {
                const appointmentId = $('#updateCustAppointmentId').val();
                const customerId = $('#updateCustId').val();
                const petId = $('#updateCustPetSelect').val();
                
                if (!petId) {
                    Swal.fire('Lỗi', 'Vui lòng chọn thú cưng!', 'error');
                    return;
                }

                $.post('/Receptionist/UpdateEmergencyCustomer', {
                    appointmentId: appointmentId,
                    customerId: customerId,
                    petId: petId
                }, function(res) {
                    if (res.success) {
                        $('#updateCustomerModal').modal('hide');
                        Swal.fire('Thành công', 'Đã ghép nối hồ sơ thành công!', 'success');
                        loadQueue();
                    } else {
                        Swal.fire('Lỗi', res.message, 'error');
                    }
                });
            });
        });
    </script>
}
