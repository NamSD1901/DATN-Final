@model MyPetClinic.Application.DTOs.PetDto

@{
    ViewData["Title"] = "Chi tiết thú cưng";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-info-circle-fill text-info me-2"></i>Chi tiết thú cưng</h4>
        <a asp-action="Index" class="btn btn-outline-secondary fw-bold rounded-4 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center mb-4">
                <div class="col-auto">
                    @if (Model.Species?.ToLower() == "mèo")
                    {
                        <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <span class="fs-1">🐱</span>
                        </div>
                    }
                    else if (Model.Species?.ToLower() == "chó")
                    {
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <span class="fs-1">🐶</span>
                        </div>
                    }
                    else
                    {
                        <div class="bg-secondary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
                            <span class="fs-1">🐾</span>
                        </div>
                    }
                </div>
                <div class="col">
                    <h2 class="fw-bold mb-1">@Model.Name</h2>
                    <p class="text-muted fs-5 mb-0">@(Model.Breed ?? Model.Species)</p>
                </div>
                <div class="col-auto">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-pencil-fill me-1"></i> Sửa
                    </a>
                </div>
            </div>

            <hr class="text-muted opacity-25">

            <div class="row g-4 mt-2">
                <div class="col-md-6 col-lg-4">
                    <label class="text-muted small fw-bold text-uppercase mb-1">Loài</label>
                    <p class="fs-5 mb-0">@Model.Species</p>
                </div>
                <div class="col-md-6 col-lg-4">
                    <label class="text-muted small fw-bold text-uppercase mb-1">Giống</label>
                    <p class="fs-5 mb-0">@(Model.Breed ?? "Không có")</p>
                </div>
                <div class="col-md-6 col-lg-4">
                    <label class="text-muted small fw-bold text-uppercase mb-1">Giới tính</label>
                    <p class="fs-5 mb-0">@(Model.Gender == 1 ? "Đực" : (Model.Gender == 2 ? "Cái" : "Khác"))</p>
                </div>
                <div class="col-md-6 col-lg-4">
                    <label class="text-muted small fw-bold text-uppercase mb-1">Ngày sinh</label>
                    <p class="fs-5 mb-0">@(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</p>
                </div>
                <div class="col-md-6 col-lg-4">
                    <label class="text-muted small fw-bold text-uppercase mb-1">Cân nặng</label>
                    <p class="fs-5 mb-0">@(Model.Weight.HasValue ? Model.Weight.Value.ToString("0.##") + " kg" : "Chưa cập nhật")</p>
                </div>
                <div class="col-md-6 col-lg-4">
                    <label class="text-muted small fw-bold text-uppercase mb-1">Màu lông</label>
                    <p class="fs-5 mb-0">@(Model.Color ?? "Chưa cập nhật")</p>
                </div>
                <div class="col-md-6 col-lg-4">
                    <label class="text-muted small fw-bold text-uppercase mb-1">Nhóm máu</label>
                    <p class="fs-5 mb-0">@(Model.BloodType ?? "Chưa cập nhật")</p>
                </div>
                <div class="col-md-6 col-lg-4">
                    <label class="text-muted small fw-bold text-uppercase mb-1">Mã Microchip</label>
                    <p class="fs-5 mb-0">@(Model.MicrochipCode ?? "Không có")</p>
                </div>
                <div class="col-md-6 col-lg-4">
                    <label class="text-muted small fw-bold text-uppercase mb-1">Tình trạng triệt sản</label>
                    <p class="fs-5 mb-0">
                        @if(Model.Sterilized == true)
                        {
                            <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i> Đã triệt sản</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary rounded-pill px-3 py-2"><i class="bi bi-x-circle me-1"></i> Chưa triệt sản</span>
                        }
                    </p>
                </div>
                <div class="col-12">
                    <label class="text-muted small fw-bold text-uppercase mb-1">Ghi chú dị ứng / Sức khỏe</label>
                    <div class="p-3 bg-light rounded-3 text-dark">
                        @(string.IsNullOrEmpty(Model.AllergyNote) ? "Không có ghi chú nào." : Model.AllergyNote)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
