@model IEnumerable<MyPetClinic.Application.DTOs.PetDto>
@{
    ViewData["Title"] = "Thú cưng của tôi";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-heptagon-fill text-warning me-2"></i>Thú cưng của tôi</h4>
        <a asp-action="Create" class="btn btn-warning fw-bold rounded-4 shadow-sm">
            <i class="bi bi-plus-circle-fill me-1"></i> Thêm thú cưng
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 text-center py-5">
                    <div class="card-body">
                        <i class="bi bi-emoji-frown fs-1 text-muted mb-3 d-block"></i>
                        <h5 class="text-muted">Bạn chưa có thú cưng nào.</h5>
                        <p class="text-muted small mb-4">Hãy thêm thú cưng để dễ dàng quản lý sức khỏe và lịch hẹn nhé!</p>
                        <a asp-action="Create" class="btn btn-outline-warning fw-bold rounded-pill px-4">Thêm ngay</a>
                    </div>
                </div>
            </div>
        }
        else
        {
            foreach (var pet in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100 position-relative overflow-hidden">
                        <div class="position-absolute top-0 end-0 p-3">
                            <a asp-action="Edit" asp-route-id="@pet.Id" class="btn btn-sm btn-light rounded-circle shadow-sm text-primary" title="Sửa thông tin">
                                <i class="bi bi-pencil-fill"></i>
                            </a>
                        </div>
                        <div class="card-body p-4 text-center">
                            <div class="mb-3">
                                @if (pet.Species?.ToLower() == "mèo")
                                {
                                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                        <span class="fs-1">🐱</span>
                                    </div>
                                }
                                else if (pet.Species?.ToLower() == "chó")
                                {
                                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                        <span class="fs-1">🐶</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="bg-secondary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                        <span class="fs-1">🐾</span>
                                    </div>
                                }
                            </div>
                            <h5 class="fw-bold mb-1">@pet.Name</h5>
                            <p class="text-muted small mb-3">@(pet.Breed ?? pet.Species)</p>
                            
                            <ul class="list-group list-group-flush text-start small">
                                <li class="list-group-item px-0 border-0 py-1">
                                    <span class="text-muted"><i class="bi bi-gender-ambiguous me-2"></i>Giới tính:</span> 
                                    <span class="fw-medium float-end">@(pet.Gender == 1 ? "Đực" : (pet.Gender == 2 ? "Cái" : "Khác"))</span>
                                </li>
                                <li class="list-group-item px-0 border-0 py-1">
                                    <span class="text-muted"><i class="bi bi-calendar-heart me-2"></i>Tuổi:</span> 
                                    <span class="fw-medium float-end">
                                        @(pet.BirthDate.HasValue ? (DateTime.Now.Year - pet.BirthDate.Value.Year).ToString() + " tuổi" : "Chưa cập nhật")
                                    </span>
                                </li>
                                <li class="list-group-item px-0 border-0 py-1">
                                    <span class="text-muted"><i class="bi bi-speedometer2 me-2"></i>Cân nặng:</span> 
                                    <span class="fw-medium float-end">@(pet.Weight.HasValue ? pet.Weight.Value.ToString("0.##") + " kg" : "--")</span>
                                </li>
                            </ul>
                        </div>
                        <div class="card-footer bg-transparent border-top-0 p-3 text-center">
                            <span class="badge @(pet.Sterilized ? "bg-success" : "bg-secondary") rounded-pill">
                                @(pet.Sterilized ? "Đã triệt sản" : "Chưa triệt sản")
                            </span>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
