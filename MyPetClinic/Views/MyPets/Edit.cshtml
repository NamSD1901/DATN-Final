@model MyPetClinic.Application.DTOs.UpdatePetDto
@{
    ViewData["Title"] = "Cập nhật thú cưng";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}
@{
    var predefinedSpecies = new List<string> { "Chó", "Mèo", "Chim", "Chuột" };
    var isOtherSpecies = !string.IsNullOrEmpty(Model.Species) && !predefinedSpecies.Contains(Model.Species);
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-light rounded-circle shadow-sm me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h4 class="fw-bold mb-0 text-dark">Chỉnh sửa thú cưng</h4>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-bold small text-muted">Tên thú cưng <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control rounded-3 py-2" placeholder="Ví dụ: Milu, Miu..." />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="Species" class="form-label fw-bold small text-muted">Giống loài <span class="text-danger">*</span></label>
                                <select id="Species" name="@(!isOtherSpecies ? "Species" : "")" class="form-select rounded-3 py-2" onchange="toggleOtherSpecies()">
                                    <option value="">-- Chọn giống loài --</option>
                                    <option value="Chó" selected="@(Model.Species == "Chó")">Chó</option>
                                    <option value="Mèo" selected="@(Model.Species == "Mèo")">Mèo</option>
                                    <option value="Chim" selected="@(Model.Species == "Chim")">Chim</option>
                                    <option value="Chuột" selected="@(Model.Species == "Chuột")">Chuột / Hamster</option>
                                    <option value="Khác" selected="@isOtherSpecies">Khác</option>
                                </select>
                                <input type="text" id="otherSpeciesInput" name="@(isOtherSpecies ? "Species" : "")" 
                                       class="form-control rounded-3 py-2 mt-2" 
                                       placeholder="Nhập tên giống loài khác..." 
                                       style="@(isOtherSpecies ? "display: block;" : "display: none;")" 
                                       value="@(isOtherSpecies ? Model.Species : "")" />
                                <span asp-validation-for="Species" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Breed" class="form-label fw-bold small text-muted">Giống (Loại)</label>
                                <input asp-for="Breed" class="form-control rounded-3 py-2" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label fw-bold small text-muted">Giới tính</label>
                                <select asp-for="Gender" class="form-select rounded-3 py-2">
                                    <option value="">-- Chọn giới tính --</option>
                                    <option value="1">Đực</option>
                                    <option value="2">Cái</option>
                                    <option value="3">Khác</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="BirthDate" class="form-label fw-bold small text-muted">Ngày sinh</label>
                                <input asp-for="BirthDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control rounded-3 py-2" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Weight" class="form-label fw-bold small text-muted">Cân nặng (kg)</label>
                                <input asp-for="Weight" type="number" step="0.1" class="form-control rounded-3 py-2" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Color" class="form-label fw-bold small text-muted">Màu sắc</label>
                                <input asp-for="Color" class="form-control rounded-3 py-2" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="BloodType" class="form-label fw-bold small text-muted">Nhóm máu</label>
                                <input asp-for="BloodType" class="form-control rounded-3 py-2" />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MicrochipCode" class="form-label fw-bold small text-muted">Mã Microchip</label>
                                <input asp-for="MicrochipCode" class="form-control rounded-3 py-2" />
                            </div>

                            <div class="col-md-6 d-flex align-items-center mt-md-5">
                                <div class="form-check form-switch fs-5">
                                    <input class="form-check-input" type="checkbox" asp-for="Sterilized" role="switch">
                                    <label class="form-check-label fs-6 mt-1 ms-2" asp-for="Sterilized">Đã triệt sản</label>
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="AllergyNote" class="form-label fw-bold small text-muted">Ghi chú dị ứng / Sức khỏe</label>
                                <textarea asp-for="AllergyNote" class="form-control rounded-3" rows="3"></textarea>
                            </div>

                            <div class="col-12 mt-4 text-end">
                                <button type="submit" class="btn btn-warning fw-bold px-4 rounded-3 text-dark shadow-sm">
                                    <i class="bi bi-floppy-fill me-2"></i> Lưu thay đổi
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function toggleOtherSpecies() {
            var select = document.getElementById('Species');
            var input = document.getElementById('otherSpeciesInput');
            if (select.value === 'Khác') {
                input.style.display = 'block';
                input.setAttribute('name', 'Species');
                select.removeAttribute('name');
                input.required = true;
            } else {
                input.style.display = 'none';
                input.removeAttribute('name');
                select.setAttribute('name', 'Species');
                input.required = false;
            }
        }
        
        window.onload = function() {
            toggleOtherSpecies();
        };
    </script>
}
