@{
    ViewData["Title"] = "Trang Quản Trị";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <h1 class="h3 mb-4 text-gray-800">Bảng Điều Khiển Quản Trị Viên</h1>
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Tổng quan hệ thống</h6>
                </div>
                <div class="card-body">
                    <p>Chào mừng Admin đến với khu vực quản trị của MyPetClinic.</p>
                    <p>Tại đây bạn có thể quản lý người dùng, dịch vụ, và xem các báo cáo thống kê.</p>
                    <!-- Bạn có thể bổ sung các thẻ thống kê ở đây -->
                </div>
            </div>
        </div>
    </div>
</div>
