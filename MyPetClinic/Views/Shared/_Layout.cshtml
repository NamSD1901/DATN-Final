<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyPetClinic</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyPetClinic.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-premium navbar-light">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-heart-pulse-fill brand-accent"></i>
                    MyPet<span class="brand-accent">Clinic</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        
                        <!-- Dropdown Giới thiệu -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Giới thiệu
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="History"><i class="bi bi-file-person me-2"></i>Lịch sử phát triển</a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Team"><i class="bi bi-people-fill me-2"></i>Đội ngũ nhân viên</a></li>
                            </ul>
                        </li>

                        <!-- Dropdown Dịch Vụ (Cơ cấu theo petcare.vn) -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Dịch vụ thú y
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item fw-bold d-flex justify-content-between align-items-center" href="#khamDieuTriSubmenu" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="khamDieuTriSubmenu" onclick="event.stopPropagation();">
                                        <span><i class="bi bi-search-heart text-primary me-2"></i>Khám và điều trị</span>
                                        <i class="bi bi-chevron-down small text-muted ms-2"></i>
                                    </a>
                                    <div class="collapse" id="khamDieuTriSubmenu">
                                        <ul class="list-unstyled ps-1 py-1 my-1" style="background-color: var(--primary-cream); border-radius: var(--radius-sm);">
                                            <li><a class="dropdown-item ps-4 py-1 text-muted small" href="/Home/KhamDieuTri#tong-quat"><i class="bi bi-arrow-return-right me-2 text-success"></i>Khám tổng quát</a></li>
                                            <li><a class="dropdown-item ps-4 py-1 text-muted small" href="/Home/KhamDieuTri#chuyen-khoa"><i class="bi bi-arrow-return-right me-2 text-warning"></i>Khám chuyên khoa</a></li>
                                            <li><a class="dropdown-item ps-4 py-1 text-muted small" href="/Home/KhamDieuTri#chan-doan-hinh-anh"><i class="bi bi-arrow-return-right me-2 text-primary"></i>Chẩn đoán hình ảnh</a></li>
                                            <li><a class="dropdown-item ps-4 py-1 text-muted small" href="/Home/KhamDieuTri#dieu-tri"><i class="bi bi-arrow-return-right me-2 text-danger"></i>Điều trị bệnh</a></li>
                                            <li><a class="dropdown-item ps-4 py-1 text-muted small" href="/Home/KhamDieuTri#cham-soc"><i class="bi bi-arrow-return-right me-2 text-info"></i>Chăm sóc sau điều trị</a></li>
                                            <li><a class="dropdown-item ps-4 py-1 text-muted small" href="/Home/KhamDieuTri#phau-thuat"><i class="bi bi-arrow-return-right me-2 text-secondary"></i>Phẫu thuật ngoại khoa</a></li>
                                            <li><a class="dropdown-item ps-4 py-1 text-muted small" href="/Home/KhamDieuTri#xet-nghiem"><i class="bi bi-arrow-return-right me-2 text-dark"></i>Xét nghiệm & Siêu âm</a></li>
                                        </ul>
                                    </div>
                                </li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="TiemPhong"><i class="bi bi-patch-check text-info me-2"></i>Tiêm phòng bệnh</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="SpaGrooming"><i class="bi bi-scissors text-secondary me-2"></i>Spa & Thẩm mỹ cắt tỉa</a></li>
                            </ul>
                        </li>

                        <!-- Dropdown Tin tức -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Kiến thức
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="TinTuc"><i class="bi bi-newspaper me-2"></i>Tin tức sự kiện</a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="SucKhoe"><i class="bi bi-journal-medical me-2"></i>Sức khỏe thú cưng</a></li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Liên hệ</a>
                        </li>
                    </ul>

                    <!-- User Actions -->
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <a class="btn btn-premium-outline dropdown-toggle d-flex align-items-center gap-2 shadow-sm py-2 px-3 border-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-color: var(--primary-gold);">
                                    <i class="bi bi-person-circle fs-5 text-warning"></i>
                                    <span class="fw-bold text-dark">@User.Identity.Name</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end mt-2 border-0 shadow">
                                    @{ var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value?.ToLower(); }
                                    @if(userRole == "customer")
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2-fill text-warning me-2"></i>Hồ sơ Khách Hàng</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    
                                    @if(userRole == "doctor")
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-person text-danger me-2"></i>Hồ sơ của tôi</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Veterinarian" asp-action="Index"><i class="bi bi-heart-pulse text-danger me-2"></i>Lịch Khám Bác Sĩ</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }

                                    @if(userRole == "admin")
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-person text-primary me-2"></i>Hồ sơ của tôi</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index"><i class="bi bi-gear-fill text-primary me-2"></i>Trang Quản Trị</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }

                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-start">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-premium-outline py-2 px-3">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng Nhập
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-premium-outline py-2 px-3 d-none d-sm-inline-block">
                                <i class="bi bi-person-plus me-1"></i>Đăng Ký
                            </a>
                        }

                        <button class="btn btn-premium shadow-sm ms-2" type="button" data-bs-toggle="modal" data-bs-target="#contactAdviceModal">
                            <i class="bi bi-calendar-check me-1"></i>Đặt Lịch Ngay
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid p-0">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Premium Footer matching petcare.vn info structure -->
    <footer class="footer-premium bg-footer-dark reveal-fade">
        <div class="container">
            <div class="row g-4">
                <!-- Col 1: Brand Info -->
                <div class="col-lg-3 col-md-6">
                    <h5 class="navbar-brand text-white mb-3">
                        <i class="bi bi-heart-pulse-fill text-warning"></i>
                        MyPet<span class="text-warning">Clinic</span>
                    </h5>
                    <p class="text-white-50 small mb-3">
                        Bệnh viện thú y chất lượng hàng đầu Việt Nam. Nơi chăm sóc toàn diện, chẩn đoán chính xác và điều trị tận tâm bằng tình yêu thương lớn nhất dành cho thú cưng của bạn.
                    </p>
                    <div class="d-flex gap-2">
                        <a href="https://facebook.com" class="btn btn-sm btn-outline-light rounded-circle"><i class="bi bi-facebook"></i></a>
                        <a href="https://youtube.com" class="btn btn-sm btn-outline-light rounded-circle"><i class="bi bi-youtube"></i></a>
                        <a href="https://instagram.com" class="btn btn-sm btn-outline-light rounded-circle"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>

                <!-- Col 2: Locations & Hotlines -->
                <div class="col-lg-3 col-md-6" id="contact">
                    <h6 class="footer-title">Địa Chỉ Liên Hệ</h6>
                    <div class="small text-white-50">
                        <p class="mb-0">
                            <strong class="text-warning">MyPetClinic (Trụ sở chính):</strong><br />
                            124A Xuân Thủy, P. An Khánh, TP. HCM<br />
                            <i class="bi bi-telephone-fill me-1"></i> Hotline: 0905 090 629
                        </p>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-title">Giờ Làm Việc</h6>
                    <div class="small text-white-50">
                        <p class="mb-2">
                            <strong class="text-white">Thứ 2 - Thứ 7:</strong><br />
                            Sáng: 08:00 - 12:00 | Chiều: 14:00 - 19:00
                        </p>
                        <p class="mb-3">
                            <strong class="text-white">Chủ nhật & Ngày Lễ:</strong><br />
                            Sáng: 08:00 - 12:00 (Chiều nghỉ)
                        </p>
                    </div>
                </div>

                <!-- Col 4: Quick Map -->
                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-title">Bản Đồ Chỉ Đường</h6>
                    <div class="rounded-3 overflow-hidden border border-secondary border-opacity-50 shadow-sm" style="height: 150px;">
                        <iframe style="border: 0; width: 100%; height: 100%;" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3920.0531119583807!2d106.70744515079734!3d10.73038709231523!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f91a2a96ad1%3A0xc19a98cc93ec317e!2sPetcare+Veterinary+Hospital!5e0!3m2!1sen!2s!4v1465265330727" frameborder="0" allowfullscreen="allowfullscreen"></iframe>
                    </div>
                    <p class="mt-2 text-end mb-0">
                        <a href="mailto:info@petcare.vn" class="text-warning small text-decoration-none"><i class="bi bi-envelope-at me-1"></i>info@petcare.vn</a>
                    </p>
                </div>
            </div>
            <hr class="border-secondary border-opacity-50 my-4" />
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start small text-white-50">
                    &copy; 2026 - <strong class="text-white">MyPetClinic.vn</strong>. Tất cả quyền được bảo lưu.
                </div>
                <div class="col-md-6 text-center text-md-end small text-white-50 mt-2 mt-md-0">
                    <a href="#" class="text-white-50 text-decoration-none me-3">Quy định sử dụng</a> | <a href="#" class="text-white-50 text-decoration-none ms-3">Chính sách bảo mật</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Modal Đặt Lịch Ngay -->
    <div class="modal fade" id="contactAdviceModal" tabindex="-1" aria-labelledby="contactAdviceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header bg-warning text-dark border-0 py-3 rounded-top-4">
                    <h5 class="modal-title fw-bold" id="contactAdviceModalLabel">
                        <i class="bi bi-calendar-check me-2"></i>Đặt Lịch Ngay
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-4 text-center">
                        Vui lòng điền đầy đủ thông tin bên dưới để đăng ký lịch hẹn cho thú cưng của bạn tại MyPetClinic.
                    </p>
                    <form id="bookingFormModal" onsubmit="handleBookingSubmit(event)">
                        <div class="row g-2">
                            <!-- Họ tên & SĐT -->
                            <div class="col-md-6">
                                <div class="form-floating mb-2">
                                    <input type="text" class="form-control input-premium rounded-3" id="bookingOwnerName" required placeholder="Nguyễn Văn A" />
                                    <label for="bookingOwnerName"><i class="bi bi-person me-1 text-muted"></i> Họ và tên *</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-2">
                                    <input type="tel" class="form-control input-premium rounded-3" id="bookingPhone" required placeholder="0901234567" />
                                    <label for="bookingPhone"><i class="bi bi-telephone me-1 text-muted"></i> Số điện thoại *</label>
                                </div>
                            </div>

                            <!-- Tên Pet & Loại Pet -->
                            <div class="col-md-6">
                                <div class="form-floating mb-2">
                                    <input type="text" class="form-control input-premium rounded-3" id="bookingPetName" required placeholder="Milu" />
                                    <label for="bookingPetName"><i class="bi bi-heart me-1 text-muted"></i> Tên thú cưng *</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-2">
                                    <select class="form-select input-premium rounded-3" id="bookingPetType" required>
                                        <option value="Chó">Chó</option>
                                        <option value="Mèo">Mèo</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                    <label for="bookingPetType"><i class="bi bi-gender-ambiguous me-1 text-muted"></i> Loại thú cưng</label>
                                </div>
                            </div>

                            <!-- Dịch vụ & Ngày hẹn -->
                            <div class="col-md-6">
                                <div class="form-floating mb-2">
                                    <select class="form-select input-premium rounded-3" id="bookingService" required>
                                        <option value="Khám & Điều trị">Khám & Điều trị</option>
                                        <option value="Tiêm phòng">Tiêm phòng Vaccine</option>
                                        <option value="Spa & Grooming">Spa & Làm đẹp</option>
                                        <option value="Dịch vụ khác">Dịch vụ khác</option>
                                    </select>
                                    <label for="bookingService"><i class="bi bi-journal-medical me-1 text-muted"></i> Chọn dịch vụ *</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-2">
                                    <input type="date" class="form-control input-premium rounded-3" id="bookingDate" required />
                                    <label for="bookingDate"><i class="bi bi-calendar me-1 text-muted"></i> Ngày đặt lịch *</label>
                                </div>
                            </div>

                            <!-- Giờ hẹn -->
                            <div class="col-md-12">
                                <div class="form-floating mb-2">
                                    <select class="form-select input-premium rounded-3" id="bookingTime" required>
                                        <option value="08:00 - 09:00">Ca sáng: 08:00 - 09:00</option>
                                        <option value="09:00 - 10:00">Ca sáng: 09:00 - 10:00</option>
                                        <option value="10:00 - 11:00">Ca sáng: 10:00 - 11:00</option>
                                        <option value="11:00 - 12:00">Ca sáng: 11:00 - 12:00</option>
                                        <option value="14:00 - 15:00">Ca chiều: 14:00 - 15:00</option>
                                        <option value="15:00 - 16:00">Ca chiều: 15:00 - 16:00</option>
                                        <option value="16:00 - 17:00">Ca chiều: 16:00 - 17:00</option>
                                        <option value="17:00 - 18:00">Ca chiều: 17:00 - 18:00</option>
                                        <option value="18:00 - 19:00">Ca chiều: 18:00 - 19:00</option>
                                    </select>
                                    <label for="bookingTime"><i class="bi bi-clock me-1 text-muted"></i> Giờ hẹn mong muốn *</label>
                                </div>
                            </div>

                            <!-- Triệu chứng / Ghi chú -->
                            <div class="col-md-12">
                                <div class="form-floating mb-3">
                                    <textarea class="form-control input-premium rounded-3" id="bookingNotes" style="height: 80px;" placeholder="Ví dụ: Bé bị ho, cần tắm spa..."></textarea>
                                    <label for="bookingNotes"><i class="bi bi-chat-left-text me-1 text-muted"></i> Triệu chứng / Ghi chú thêm</label>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-premium w-100 py-3 shadow-md">
                            <i class="bi bi-calendar-check-fill me-1"></i> Xác Nhận Đặt Lịch
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const today = new Date().toISOString().split('T')[0];
            const bookingDateModal = document.getElementById('bookingDate');
            if (bookingDateModal) {
                bookingDateModal.min = today;
                bookingDateModal.value = today;
        });

        function handleBookingSubmit(event) {
            event.preventDefault();
            const ownerName = document.getElementById('bookingOwnerName').value;
            const phone = document.getElementById('bookingPhone').value;
            const petName = document.getElementById('bookingPetName').value;
            const petType = document.getElementById('bookingPetType').value;
            const service = document.getElementById('bookingService').value;
            const date = document.getElementById('bookingDate').value;
            const time = document.getElementById('bookingTime').value;

            alert(`Đặt lịch thành công!\n\nThông tin lịch hẹn:\n- Khách hàng: ${ownerName}\n- SĐT: ${phone}\n- Thú cưng: ${petName} (${petType})\n- Dịch vụ: ${service}\n- Thời gian: ${time} ngày ${date}\n\nMyPetClinic sẽ liên hệ lại với bạn sớm nhất để xác nhận lịch hẹn.`);
            
            const modalEl = document.getElementById('contactAdviceModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) {
                modal.hide();
            }
            document.getElementById('bookingFormModal').reset();
            const today = new Date().toISOString().split('T')[0];
            const bookingDateModal = document.getElementById('bookingDate');
            if (bookingDateModal) {
                bookingDateModal.value = today;
            }
        }
    </script>
</body>
</html>
