@model IEnumerable<MyPetClinic.Domain.Entities.User>
@{
    ViewData["Title"] = "Quản lý Khách hàng";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .search-bar-card {
        background: linear-gradient(135deg, #fff9e6, #ffffff);
        border: 1px solid #f1c40f;
        border-radius: 16px;
    }
    .customer-card {
        border: none;
        border-radius: 14px;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .customer-card:hover {
        box-shadow: 0 6px 20px rgba(241,196,15,0.2);
        transform: translateY(-2px);
    }
    .badge-customer {
        background: #fef9e7;
        color: #d4ac0d;
        border: 1px solid #f1c40f;
    }
    .btn-gold {
        background: linear-gradient(135deg, #f1c40f, #f39c12);
        color: #fff;
        font-weight: 600;
        border: none;
        border-radius: 10px;
        transition: all 0.2s;
    }
    .btn-gold:hover { filter: brightness(1.08); color: #fff; }
    .table thead th { background: #fdfaf0; font-size: 0.82rem; text-transform: uppercase; color: #888; }
    .avatar-circle {
        width: 42px; height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f1c40f, #f39c12);
        color: white;
        font-weight: 700;
        font-size: 1.1rem;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .quick-search-result {
        border: 2px solid #f1c40f;
        border-radius: 14px;
        background: #fffdf0;
    }
</style>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-people-fill text-warning me-2"></i>Quản lý Khách hàng</h4>
        <small class="text-muted">Tìm kiếm, thêm mới và quản lý hồ sơ khách hàng</small>
    </div>
    <a asp-action="CreateCustomer" class="btn btn-gold px-4 py-2 shadow-sm">
        <i class="bi bi-person-plus-fill me-2"></i>Thêm Khách Hàng Mới
    </a>
</div>

<!-- Quick Phone Search (dành cho khách đến trực tiếp) -->
<div class="card search-bar-card mb-4 p-3">
    <div class="row align-items-center g-2">
        <div class="col-auto">
            <span class="fw-bold text-warning"><i class="bi bi-search me-1"></i>Tìm nhanh SĐT:</span>
        </div>
        <div class="col-md-4">
            <div class="input-group">
                <input type="text" id="quickPhoneInput" class="form-control rounded-start-pill" placeholder="Nhập số điện thoại...">
                <button class="btn btn-warning rounded-end-pill fw-bold" onclick="quickSearch()">
                    <i class="bi bi-phone-fill me-1"></i>Tra cứu
                </button>
            </div>
        </div>
        <div class="col-auto text-muted small">↳ Dành cho khách đến trực tiếp không có mã QR</div>
    </div>
    <div id="quickSearchResult" class="mt-3 d-none">
        <div class="quick-search-result p-3 d-flex align-items-start gap-3">
            <div class="avatar-circle" id="qsrAvatar">?</div>
            <div id="qsrContent" class="flex-grow-1"></div>
        </div>
    </div>
    <div id="quickSearchNotFound" class="mt-3 d-none alert alert-warning d-flex align-items-center gap-2 mb-0">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>Không tìm thấy khách hàng với số điện thoại này. <a asp-action="CreateCustomer" class="fw-bold text-warning">Tạo hồ sơ mới?</a></span>
    </div>
</div>

<!-- Search Form + Table -->
<div class="card customer-card">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-bold text-muted">Tìm kiếm theo tên / SĐT / Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Nhập từ khóa...">
                    <button type="submit" class="btn btn-gold">Tìm</button>
                    @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                    {
                        <a asp-action="Customers" class="btn btn-outline-secondary">Xóa lọc</a>
                    }
                </div>
            </div>
            <div class="col-auto ms-auto">
                <span class="text-muted small">Tổng cộng: <strong>@Model.Count()</strong> khách hàng</span>
            </div>
        </form>

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox display-4 d-block mb-3 opacity-25"></i>
                <p>Không tìm thấy khách hàng nào.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Khách hàng</th>
                            <th>Liên hệ</th>
                            <th>Địa chỉ</th>
                            <th>Ngày tạo</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle" style="width:36px;height:36px;font-size:0.9rem;">
                                            @(customer.FullName?.Substring(0, 1).ToUpper() ?? "?")
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@customer.FullName</div>
                                            <small class="text-muted">@customer.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(customer.Phone))
                                    {
                                        <span class="badge badge-customer"><i class="bi bi-phone me-1"></i>@customer.Phone</span>
                                    }
                                </td>
                                <td class="text-muted small">@(customer.Address ?? "—")</td>
                                <td class="text-muted small">@customer.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <a asp-action="CustomerDetail" asp-route-id="@customer.Id"
                                       class="btn btn-sm btn-outline-warning fw-bold rounded-pill">
                                        <i class="bi bi-eye me-1"></i>Xem Hồ Sơ
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
async function quickSearch() {
    const phone = document.getElementById('quickPhoneInput').value.trim();
    if (!phone) return;

    const resultBox = document.getElementById('quickSearchResult');
    const notFoundBox = document.getElementById('quickSearchNotFound');
    resultBox.classList.add('d-none');
    notFoundBox.classList.add('d-none');

    try {
        const resp = await fetch(`/Receptionist/QuickSearch?phone=${encodeURIComponent(phone)}`);
        const data = await resp.json();

        if (!data.found) {
            notFoundBox.classList.remove('d-none');
            return;
        }

        document.getElementById('qsrAvatar').innerText = data.fullName?.charAt(0)?.toUpperCase() ?? '?';

        let petsHtml = '';
        if (data.pets && data.pets.length > 0) {
            petsHtml = '<div class="mt-2"><strong>Thú cưng:</strong> ';
            petsHtml += data.pets.map(p => `<span class="badge bg-light text-dark border me-1"><i class="bi bi-heart-pulse text-warning"></i> ${p.name} (${p.species ?? '?'})</span>`).join('');
            petsHtml += '</div>';
        } else {
            petsHtml = '<div class="mt-2 text-muted small"><i class="bi bi-info-circle me-1"></i>Chưa có thú cưng trong hồ sơ.</div>';
        }

        document.getElementById('qsrContent').innerHTML = `
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <div class="fw-bold fs-6">${data.fullName ?? 'N/A'}</div>
                    <small class="text-muted"><i class="bi bi-phone me-1"></i>${data.phone ?? ''} | <i class="bi bi-envelope me-1"></i>${data.email ?? ''}</small>
                    ${petsHtml}
                </div>
                <div class="d-flex gap-2">
                    <a href="/Receptionist/CustomerDetail/${data.customerId}" class="btn btn-gold btn-sm"><i class="bi bi-eye me-1"></i>Xem Hồ Sơ</a>
                    <a href="/Receptionist/AddPet?customerId=${data.customerId}" class="btn btn-outline-warning btn-sm"><i class="bi bi-plus-circle me-1"></i>Thêm Thú Cưng</a>
                </div>
            </div>
        `;
        resultBox.classList.remove('d-none');
    } catch (e) {
        console.error(e);
    }
}

// Nhấn Enter trong input cũng tìm kiếm
document.getElementById('quickPhoneInput').addEventListener('keypress', function(e) {
    if (e.key === 'Enter') quickSearch();
});
</script>
}
