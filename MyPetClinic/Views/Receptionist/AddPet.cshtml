@{
    ViewData["Title"] = "Thêm Thú Cưng";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var customer = ViewBag.Customer as MyPetClinic.Domain.Entities.User;
}

<style>
    .form-card { border: none; border-radius: 18px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
    .section-header { font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: #f39c12; letter-spacing: 0.05em; border-bottom: 2px solid #fef9e7; padding-bottom: 8px; margin-bottom: 16px; }
    .form-label { font-size: 0.88rem; font-weight: 600; color: #444; }
    .btn-gold { background: linear-gradient(135deg, #f1c40f, #f39c12); color: #fff; font-weight: 600; border: none; border-radius: 10px; }
    .btn-gold:hover { filter: brightness(1.08); color: #fff; }
    .form-control:focus, .form-select:focus { border-color: #f1c40f; box-shadow: 0 0 0 3px rgba(241,196,15,0.15); }
    .owner-badge { background: #fef9e7; border: 1px solid #f1c40f; border-radius: 12px; }
    .species-btn { border: 2px solid #e0e0e0; border-radius: 12px; cursor: pointer; padding: 12px; text-align: center; transition: all 0.2s; }
    .species-btn:hover, .species-btn.active { border-color: #f1c40f; background: #fef9e7; }
    .species-btn .emoji { font-size: 2rem; }
</style>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Customers" class="text-warning text-decoration-none">Khách hàng</a></li>
        <li class="breadcrumb-item"><a asp-action="CustomerDetail" asp-route-id="@customer?.Id" class="text-warning text-decoration-none">@customer?.FullName</a></li>
        <li class="breadcrumb-item active">Thêm Thú Cưng</li>
    </ol>
</nav>

<h4 class="fw-bold mb-4"><i class="bi bi-plus-circle-fill text-warning me-2"></i>Thêm Thú Cưng Mới</h4>

<!-- Owner Info -->
<div class="owner-badge p-3 mb-4 d-flex align-items-center gap-3">
    <div style="width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#f1c40f,#f39c12);color:#fff;font-weight:700;font-size:1.1rem;display:flex;align-items:center;justify-content:center;">
        @(customer?.FullName?.Substring(0, 1).ToUpper() ?? "?")
    </div>
    <div>
        <div class="fw-bold">Chủ sở hữu: @customer?.FullName</div>
        <small class="text-muted">@customer?.Phone | @customer?.Email</small>
    </div>
</div>

<div class="card form-card p-4">
    <form asp-action="AddPet" method="post" id="addPetForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="customerId" value="@customer?.Id">
        <input type="hidden" name="Species" id="hiddenSpecies">

        <!-- Loài -->
        <div class="section-header"><i class="bi bi-heart-pulse me-2"></i>Loại Thú Cưng</div>
        <div class="row g-3 mb-4" id="speciesSelector">
            <div class="col-6 col-md-3">
                <div class="species-btn" onclick="selectSpecies('Chó', this)">
                    <div class="emoji">🐕</div>
                    <div class="fw-semibold mt-1">Chó</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="species-btn" onclick="selectSpecies('Mèo', this)">
                    <div class="emoji">🐈</div>
                    <div class="fw-semibold mt-1">Mèo</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="species-btn" onclick="selectSpecies('Thỏ', this)">
                    <div class="emoji">🐇</div>
                    <div class="fw-semibold mt-1">Thỏ</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="species-btn" onclick="selectSpecies('Khác', this)">
                    <div class="emoji">🐾</div>
                    <div class="fw-semibold mt-1">Khác</div>
                </div>
            </div>
        </div>

        <!-- Thông tin cơ bản -->
        <div class="section-header"><i class="bi bi-info-circle me-2"></i>Thông Tin Cơ Bản</div>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Tên thú cưng <span class="text-danger">*</span></label>
                <input type="text" name="Name" class="form-control" placeholder="VD: Mochi, Bông, Gấu..." required>
            </div>
            <div class="col-md-6">
                <label class="form-label">Giống / Breed</label>
                <input type="text" name="Breed" class="form-control" placeholder="VD: Corgi, Persian, Golden...">
            </div>
            <div class="col-md-3">
                <label class="form-label">Giới tính</label>
                <select name="Gender" class="form-select">
                    <option value="">— Chọn —</option>
                    <option value="1">Đực</option>
                    <option value="0">Cái</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Màu lông</label>
                <input type="text" name="Color" class="form-control" placeholder="VD: Vàng, Trắng...">
            </div>
            <div class="col-md-3">
                <label class="form-label">Ngày sinh (dự kiến)</label>
                <input type="date" name="BirthDate" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label">Cân nặng (kg)</label>
                <input type="number" name="Weight" class="form-control" step="0.01" min="0" max="999.99" placeholder="VD: 3.5">
            </div>
        </div>

        <!-- Thông tin y tế -->
        <div class="section-header"><i class="bi bi-clipboard2-pulse me-2"></i>Thông Tin Y Tế</div>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Mã Microchip</label>
                <input type="text" name="MicrochipCode" class="form-control" placeholder="Mã chip điện tử (nếu có)">
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check form-switch ms-2">
                    <input class="form-check-input" type="checkbox" name="Sterilized" value="true" id="sterilizedCheck">
                    <label class="form-check-label fw-semibold" for="sterilizedCheck">Đã triệt sản</label>
                </div>
            </div>
            <div class="col-md-12">
                <label class="form-label">Ghi chú dị ứng / bệnh lý đặc biệt</label>
                <textarea name="AllergyNote" class="form-control" rows="2" placeholder="VD: Dị ứng với Penicillin, tiền sử bệnh tim..."></textarea>
            </div>
        </div>

        <!-- Buttons -->
        <div class="d-flex gap-3">
            <button type="submit" class="btn btn-gold px-5 py-2">
                <i class="bi bi-check-circle-fill me-2"></i>Thêm Thú Cưng
            </button>
            <a asp-action="CustomerDetail" asp-route-id="@customer?.Id" class="btn btn-outline-secondary px-4 py-2">
                <i class="bi bi-x-circle me-2"></i>Hủy
            </a>
        </div>
    </form>
</div>

@section Scripts {
<script>
function selectSpecies(species, el) {
    document.querySelectorAll('.species-btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('hiddenSpecies').value = species;
}
</script>
}
