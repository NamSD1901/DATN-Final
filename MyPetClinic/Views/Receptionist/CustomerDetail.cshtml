@{
    ViewData["Title"] = "Hồ sơ Khách hàng";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var customer = ViewBag.Customer as MyPetClinic.Domain.Entities.User;
    var pets = ViewBag.Pets as IEnumerable<MyPetClinic.Domain.Entities.Pet>;
}

<style>
    .profile-header-card {
        background: linear-gradient(135deg, #fdfaf0, #fff);
        border: 1px solid #f1c40f44;
        border-radius: 18px;
    }
    .avatar-big {
        width: 80px; height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f1c40f, #f39c12);
        color: white; font-weight: 700; font-size: 2rem;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 12px rgba(241,196,15,0.4);
    }
    .info-label { font-size: 0.78rem; text-transform: uppercase; color: #aaa; font-weight: 600; }
    
    .pet-card {
        border: 2px solid #f0f0f0;
        border-radius: 14px;
        transition: all 0.2s;
    }
    .pet-card:hover { border-color: #f1c40f; box-shadow: 0 4px 16px rgba(241,196,15,0.2); }
    .pet-icon { font-size: 2.5rem; }
    .species-badge { font-size: 0.75rem; background: #f8f4e3; color: #b7900d; border-radius: 8px; padding: 2px 10px; }

    .btn-gold { background: linear-gradient(135deg, #f1c40f, #f39c12); color: #fff; font-weight: 600; border: none; border-radius: 10px; }
    .btn-gold:hover { filter: brightness(1.08); color: #fff; }
    .btn-huge-action { 
        background: linear-gradient(135deg, #e74c3c, #c0392b); 
        color: white; 
        font-weight: 700; 
        font-size: 1.1rem;
        padding: 12px 24px;
        border-radius: 50px;
        box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-huge-action:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(231, 76, 60, 0.6);
    }

    /* Tabs Customization */
    .nav-tabs-custom { border-bottom: 2px solid #f0f0f0; }
    .nav-tabs-custom .nav-link { color: #888; font-weight: 600; border: none; padding: 12px 20px; position: relative; }
    .nav-tabs-custom .nav-link.active { color: #f39c12; background: transparent; }
    .nav-tabs-custom .nav-link.active::after {
        content: ''; position: absolute; bottom: -2px; left: 0; right: 0; height: 3px;
        background: #f39c12; border-radius: 3px 3px 0 0;
    }
</style>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Customers" class="text-warning text-decoration-none">Khách hàng</a></li>
        <li class="breadcrumb-item active">@customer?.FullName</li>
    </ol>
</nav>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Profile Header -->
<div class="card profile-header-card mb-4 p-4">
    <div class="d-flex align-items-start gap-4 flex-wrap">
        <div class="avatar-big">@(customer?.FullName?.Substring(0,1).ToUpper() ?? "?")</div>
        <div class="flex-grow-1">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h3 class="fw-bold mb-1">@customer?.FullName</h3>
                    <div class="d-flex gap-3 flex-wrap mt-2">
                        @if (!string.IsNullOrEmpty(customer?.Phone))
                        {
                            <span class="text-muted"><i class="bi bi-phone-fill text-warning me-1"></i>@customer.Phone</span>
                        }
                        @if (!string.IsNullOrEmpty(customer?.Email))
                        {
                            <span class="text-muted"><i class="bi bi-envelope-fill text-warning me-1"></i>@customer.Email</span>
                        }
                        @if (!string.IsNullOrEmpty(customer?.Address))
                        {
                            <span class="text-muted"><i class="bi bi-geo-alt-fill text-warning me-1"></i>@customer.Address</span>
                        }
                    </div>
                </div>
                <div class="d-flex gap-3 align-items-center">
                    <a asp-action="Customers" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i>Quay lại
                    </a>
                    <button type="button" class="btn btn-huge-action" data-bs-toggle="modal" data-bs-target="#appointmentModal">
                        <i class="bi bi-journal-medical me-2"></i>Tiếp nhận khám ngay
                    </button>
                </div>
            </div>
            <div class="row mt-4 g-3 bg-white p-3 rounded-3 shadow-sm border">
                <div class="col-md-3">
                    <div class="info-label">Giới tính</div>
                    <div class="fw-semibold">@(customer?.Gender == 1 ? "Nam" : customer?.Gender == 0 ? "Nữ" : "—")</div>
                </div>
                <div class="col-md-3">
                    <div class="info-label">Ngày sinh</div>
                    <div class="fw-semibold">@(customer?.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</div>
                </div>
                <div class="col-md-3">
                    <div class="info-label">Tham gia</div>
                    <div class="fw-semibold">@(customer?.CreatedAt.HasValue == true ? customer.CreatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy") : "—")</div>
                </div>
                <div class="col-md-3">
                    <div class="info-label">Số thú cưng</div>
                    <div class="fw-semibold"><strong class="text-warning fs-5">@(pets?.Count() ?? 0)</strong> bé</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs nav-tabs-custom mb-4" id="profileTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="pets-tab" data-bs-toggle="tab" data-bs-target="#pets" type="button" role="tab">
            <i class="bi bi-heart-pulse-fill me-2"></i>Danh sách Thú Cưng
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button" role="tab">
            <i class="bi bi-clock-history me-2"></i>Lịch sử Khám bệnh
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">
            <i class="bi bi-person-lines-fill me-2"></i>Thông tin Mở rộng
        </button>
    </li>
</ul>

<div class="tab-content" id="profileTabsContent">
    
    <!-- TAB 1: THÚ CƯNG -->
    <div class="tab-pane fade show active" id="pets" role="tabpanel">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Thú cưng của @customer?.FullName</h5>
            <a asp-action="AddPet" asp-route-customerId="@customer?.Id" class="btn btn-gold px-3 rounded-pill">
                <i class="bi bi-plus-lg me-1"></i>Thêm bé mới
            </a>
        </div>

        @if (pets == null || !pets.Any())
        {
            <div class="text-center py-5 text-muted border rounded-3" style="background:#fafafa;">
                <i class="bi bi-emoji-frown display-4 d-block mb-3 opacity-25"></i>
                <p class="mb-3">Khách hàng này chưa có thú cưng nào trong hệ thống.</p>
                <a asp-action="AddPet" asp-route-customerId="@customer?.Id" class="btn btn-gold px-4 rounded-pill">
                    <i class="bi bi-plus-circle-fill me-2"></i>Thêm Thú Cưng Đầu Tiên
                </a>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var pet in pets)
                {
                    string speciesIcon = pet.Species?.ToLower() switch {
                        "chó" or "dog" => "🐕",
                        "mèo" or "cat" => "🐈",
                        "thỏ" or "rabbit" => "🐇",
                        "hamster" => "🐹",
                        _ => "🐾"
                    };

                    <div class="col-md-6 col-lg-4">
                        <div class="card pet-card p-3 h-100">
                            <div class="d-flex align-items-start gap-3">
                                <div class="pet-icon">@speciesIcon</div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h5 class="fw-bold mb-1 text-dark">@pet.Name</h5>
                                            <span class="species-badge">@pet.Species @(string.IsNullOrEmpty(pet.Breed) ? "" : $"• {pet.Breed}")</span>
                                        </div>
                                        <a asp-action="EditPet" asp-route-id="@pet.Id"
                                           class="btn btn-sm btn-outline-warning rounded-circle" title="Chỉnh sửa">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                    </div>
                                    <hr class="my-2" style="border-color:#f1c40f22;">
                                    <div class="row g-2 mt-1" style="font-size:0.85rem; color:#666;">
                                        <div class="col-6">
                                            <span><i class="bi bi-gender-ambiguous text-warning me-1"></i>
                                                @(pet.Gender == 1 ? "Đực" : pet.Gender == 0 ? "Cái" : "Chưa rõ")
                                            </span>
                                        </div>
                                        <div class="col-6">
                                            <span><i class="bi bi-calendar3 text-warning me-1"></i>
                                                @(pet.BirthDate?.ToString("MM/yyyy") ?? "—")
                                            </span>
                                        </div>
                                        <div class="col-6">
                                            <span><i class="bi bi-clipboard2-pulse text-warning me-1"></i>
                                                @(pet.Weight.HasValue ? $"{pet.Weight} kg" : "—")
                                            </span>
                                        </div>
                                        <div class="col-6">
                                            @if (pet.Sterilized)
                                            {
                                                <span class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Triệt sản</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(pet.AllergyNote))
                                        {
                                            <div class="col-12 mt-2 p-2 bg-danger bg-opacity-10 rounded text-danger fw-semibold">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Dị ứng: @pet.AllergyNote
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- TAB 2: LỊCH SỬ KHÁM -->
    <div class="tab-pane fade" id="history" role="tabpanel">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
            <i class="bi bi-journal-x text-muted display-4 opacity-50 mb-3"></i>
            <h5 class="text-muted">Chưa có lịch sử khám bệnh.</h5>
            <p class="text-muted small">Thông tin lịch sử khám bệnh, điều trị, tiêm phòng sẽ hiển thị tại đây.</p>
        </div>
    </div>

    <!-- TAB 3: THÔNG TIN MỞ RỘNG -->
    <div class="tab-pane fade" id="info" role="tabpanel">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h5 class="fw-bold mb-4">Thông tin bổ sung</h5>
            <p class="text-muted">Chưa có ghi chú đặc biệt nào cho khách hàng này.</p>
        </div>
    </div>
</div>

<!-- MODAL TIẾP NHẬN KHÁM -->
<div class="modal fade" id="appointmentModal" tabindex="-1" aria-labelledby="appointmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: none;">
            <div class="modal-header" style="background: linear-gradient(135deg, #fdfaf0, #fff); border-bottom: 2px solid #f1c40f44; border-radius: 20px 20px 0 0;">
                <h5 class="modal-title fw-bold text-dark" id="appointmentModalLabel"><i class="bi bi-journal-medical text-warning me-2"></i>Tiếp nhận Khám bệnh</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="appointmentForm">
                    <input type="hidden" id="customerId" name="CustomerId" value="@customer?.Id" />
                    
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Chọn Thú cưng <span class="text-danger">*</span></label>
                            <select class="form-select form-select-lg" id="petId" name="PetId" required style="border-radius: 12px; border-color: #f1c40f88;">
                                <option value="" disabled selected>-- Chọn bé cần khám --</option>
                                @if (pets != null)
                                {
                                    foreach (var p in pets)
                                    {
                                        <option value="@p.Id">@p.Name (@p.Species)</option>
                                    }
                                }
                            </select>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Dịch vụ <span class="text-danger">*</span></label>
                            <select class="form-select form-select-lg" id="serviceId" name="ServiceId" required style="border-radius: 12px; border-color: #f1c40f88;">
                                <option value="" disabled selected>-- Chọn dịch vụ --</option>
                                @if (ViewBag.Services != null)
                                {
                                    var currentCategory = "";
                                    foreach (var s in (IEnumerable<MyPetClinic.Domain.Entities.Service>)ViewBag.Services)
                                    {
                                        if (s.Category?.Name != currentCategory)
                                        {
                                            if (!string.IsNullOrEmpty(currentCategory))
                                            {
                                                @Html.Raw("</optgroup>")
                                            }
                                            currentCategory = s.Category?.Name ?? "Khác";
                                            @Html.Raw($"<optgroup label=\"{currentCategory}\">")
                                        }
                                        <option value="@s.Id">@s.Name</option>
                                    }
                                    @Html.Raw("</optgroup>")
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Bác sĩ phụ trách <span class="text-danger">*</span></label>
                            <select class="form-select" id="doctorId" name="DoctorId" required style="border-radius: 12px;">
                                <option value="" disabled selected>-- Chọn bác sĩ --</option>
                                @if (ViewBag.Doctors != null)
                                {
                                    foreach (var d in (IEnumerable<MyPetClinic.Domain.Entities.User>)ViewBag.Doctors)
                                    {
                                        <option value="@d.Id">@d.FullName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Thời gian hẹn</label>
                            <input type="datetime-local" class="form-control" id="appointmentDate" name="AppointmentDate" style="border-radius: 12px;" />
                            <small class="text-muted fst-italic">Bỏ trống nếu khám ngay lúc này</small>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Triệu chứng / Lý do khám <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="symptom" name="Symptom" rows="3" required placeholder="Vd: Bỏ ăn 2 ngày nay, nôn mửa..." style="border-radius: 12px;"></textarea>
                        </div>
                        
                        <div class="col-12">
                            <label class="form-label fw-bold">Ghi chú thêm</label>
                            <textarea class="form-control" id="note" name="Note" rows="2" placeholder="Ghi chú thêm cho bác sĩ (nếu có)" style="border-radius: 12px;"></textarea>
                        </div>
                    </div>
                    
                    <div id="appointmentError" class="alert alert-danger mt-3 d-none"></div>
                </form>
            </div>
            <div class="modal-footer" style="border-top: none; padding: 1.5rem;">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-gold rounded-pill px-4" id="btnSubmitAppointment">
                    <i class="bi bi-check2-circle me-1"></i> Tạo Phiếu Khám
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btnSubmitAppointment').addEventListener('click', async function() {
            const form = document.getElementById('appointmentForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const btn = this;
            const originalContent = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang tạo...';
            btn.disabled = true;
            
            const errorDiv = document.getElementById('appointmentError');
            errorDiv.classList.add('d-none');

            const payload = {
                CustomerId: document.getElementById('customerId').value,
                PetId: parseInt(document.getElementById('petId').value),
                ServiceId: parseInt(document.getElementById('serviceId').value),
                DoctorId: document.getElementById('doctorId').value,
                Symptom: document.getElementById('symptom').value,
                Note: document.getElementById('note').value,
                AppointmentDate: document.getElementById('appointmentDate').value ? document.getElementById('appointmentDate').value : null
            };

            try {
                const response = await fetch('/Receptionist/CreateAppointment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    // Tắt modal, chuyển tab Lịch sử khám
                    var modal = bootstrap.Modal.getInstance(document.getElementById('appointmentModal'));
                    modal.hide();
                    
                    form.reset();
                    
                    // Chuyển tab sang Lịch sử
                    var historyTab = new bootstrap.Tab(document.getElementById('history-tab'));
                    historyTab.show();
                    
                    // Tạm thời show alert, sau này có thể load lại data lịch sử qua AJAX
                    alert(result.message);
                } else {
                    errorDiv.innerHTML = result.message;
                    errorDiv.classList.remove('d-none');
                }
            } catch (err) {
                errorDiv.innerHTML = "Lỗi kết nối máy chủ!";
                errorDiv.classList.remove('d-none');
            } finally {
                btn.innerHTML = originalContent;
                btn.disabled = false;
            }
        });
    </script>
}
