@{
    ViewData["Title"] = "Hồ sơ Khách hàng";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var customer = ViewBag.Customer as MyPetClinic.Domain.Entities.User;
    var pets = ViewBag.Pets as List<MyPetClinic.Domain.Entities.Pet>;
}

<style>
    .profile-header-card {
        background: linear-gradient(135deg, #fdfaf0, #fff);
        border: 1px solid #f1c40f44;
        border-radius: 18px;
    }
    .avatar-big {
        width: 72px; height: 72px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f1c40f, #f39c12);
        color: white; font-weight: 700; font-size: 1.8rem;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 12px rgba(241,196,15,0.4);
    }
    .info-label { font-size: 0.78rem; text-transform: uppercase; color: #aaa; font-weight: 600; }
    .pet-card {
        border: 2px solid #f0f0f0;
        border-radius: 14px;
        transition: all 0.2s;
    }
    .pet-card:hover { border-color: #f1c40f; box-shadow: 0 4px 16px rgba(241,196,15,0.2); }
    .pet-icon { font-size: 2.5rem; }
    .btn-gold { background: linear-gradient(135deg, #f1c40f, #f39c12); color: #fff; font-weight: 600; border: none; border-radius: 10px; }
    .btn-gold:hover { filter: brightness(1.08); color: #fff; }
    .species-badge { font-size: 0.75rem; background: #f8f4e3; color: #b7900d; border-radius: 8px; padding: 2px 10px; }
</style>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Customers" class="text-warning text-decoration-none">Khách hàng</a></li>
        <li class="breadcrumb-item active">@customer?.FullName</li>
    </ol>
</nav>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Profile Header -->
<div class="card profile-header-card mb-4 p-4">
    <div class="d-flex align-items-start gap-4 flex-wrap">
        <div class="avatar-big">@(customer?.FullName?.Substring(0,1).ToUpper() ?? "?")</div>
        <div class="flex-grow-1">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h4 class="fw-bold mb-1">@customer?.FullName</h4>
                    <div class="d-flex gap-3 flex-wrap">
                        @if (!string.IsNullOrEmpty(customer?.Phone))
                        {
                            <span class="text-muted small"><i class="bi bi-phone-fill text-warning me-1"></i>@customer.Phone</span>
                        }
                        @if (!string.IsNullOrEmpty(customer?.Email))
                        {
                            <span class="text-muted small"><i class="bi bi-envelope-fill text-warning me-1"></i>@customer.Email</span>
                        }
                        @if (!string.IsNullOrEmpty(customer?.Address))
                        {
                            <span class="text-muted small"><i class="bi bi-geo-alt-fill text-warning me-1"></i>@customer.Address</span>
                        }
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="AddPet" asp-route-customerId="@customer?.Id" class="btn btn-gold px-3 py-2">
                        <i class="bi bi-plus-circle-fill me-1"></i>Thêm Thú Cưng
                    </a>
                    <a asp-action="Customers" class="btn btn-outline-secondary px-3 py-2">
                        <i class="bi bi-arrow-left me-1"></i>Quay lại
                    </a>
                </div>
            </div>
            <div class="row mt-3 g-3">
                <div class="col-md-3">
                    <div class="info-label">Giới tính</div>
                    <div>@(customer?.Gender == 1 ? "Nam" : customer?.Gender == 0 ? "Nữ" : "—")</div>
                </div>
                <div class="col-md-3">
                    <div class="info-label">Ngày sinh</div>
                    <div>@(customer?.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</div>
                </div>
                <div class="col-md-3">
                    <div class="info-label">Tham gia</div>
                    <div>@customer?.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                </div>
                <div class="col-md-3">
                    <div class="info-label">Số thú cưng</div>
                    <div><strong class="text-warning">@pets?.Count</strong></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Danh sách Thú Cưng -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-heart-pulse-fill text-warning me-2"></i>Danh sách Thú Cưng</h5>
</div>

@if (pets == null || !pets.Any())
{
    <div class="text-center py-5 text-muted border rounded-3" style="background:#fafafa;">
        <i class="bi bi-emoji-frown display-4 d-block mb-3 opacity-25"></i>
        <p class="mb-3">Khách hàng này chưa có thú cưng nào trong hệ thống.</p>
        <a asp-action="AddPet" asp-route-customerId="@customer?.Id" class="btn btn-gold px-4">
            <i class="bi bi-plus-circle-fill me-2"></i>Thêm Thú Cưng Đầu Tiên
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var pet in pets)
        {
            string speciesIcon = pet.Species?.ToLower() switch {
                "chó" or "dog" => "🐕",
                "mèo" or "cat" => "🐈",
                "thỏ" or "rabbit" => "🐇",
                "hamster" => "🐹",
                _ => "🐾"
            };

            <div class="col-md-4">
                <div class="card pet-card p-3">
                    <div class="d-flex align-items-start gap-3">
                        <div class="pet-icon">@speciesIcon</div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="fw-bold mb-1">@pet.Name</h6>
                                    <span class="species-badge">@pet.Species @(string.IsNullOrEmpty(pet.Breed) ? "" : $"• {pet.Breed}")</span>
                                </div>
                                <a asp-action="EditPet" asp-route-id="@pet.Id"
                                   class="btn btn-sm btn-outline-warning rounded-pill">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                            </div>
                            <div class="mt-2 row g-1" style="font-size:0.82rem; color:#777;">
                                <div class="col-6">
                                    <span><i class="bi bi-gender-ambiguous text-warning me-1"></i>
                                        @(pet.Gender == 1 ? "Đực" : pet.Gender == 0 ? "Cái" : "?")
                                    </span>
                                </div>
                                <div class="col-6">
                                    <span><i class="bi bi-calendar3 text-warning me-1"></i>
                                        @(pet.BirthDate?.ToString("dd/MM/yyyy") ?? "—")
                                    </span>
                                </div>
                                <div class="col-6">
                                    <span><i class="bi bi-clipboard2-pulse text-warning me-1"></i>
                                        @(pet.Weight.HasValue ? $"{pet.Weight} kg" : "—")
                                    </span>
                                </div>
                                @if (!string.IsNullOrEmpty(pet.AllergyNote))
                                {
                                    <div class="col-12">
                                        <span class="text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>@pet.AllergyNote</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
