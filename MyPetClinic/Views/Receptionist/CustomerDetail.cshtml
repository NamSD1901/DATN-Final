@model MyPetClinic.Web.Models.CustomerProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ Khách hàng";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var customer = Model.Customer;
    var pets = Model.Pets;
    var appointments = Model.Appointments;
}

<style>
    /* Card Styles */
    .profile-card {
        background: #fff;
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        margin-bottom: 1.5rem;
    }
    .profile-header-bg {
        background: linear-gradient(135deg, #fdfaf0 0%, #fff 100%);
        border-bottom: 1px solid #f1c40f33;
        padding: 2rem;
        border-radius: 16px 16px 0 0;
    }
    
    /* Avatars */
    .avatar-big {
        width: 90px; height: 90px;
        border-radius: 50%;
        background: linear-gradient(135deg, #f1c40f, #f39c12);
        color: white; font-weight: 700; font-size: 2.5rem;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 15px rgba(241,196,15,0.4);
    }
    
    /* Typography & Badges */
    .info-label { font-size: 0.75rem; text-transform: uppercase; color: #888; font-weight: 700; letter-spacing: 0.5px; }
    .badge-gold { background: #fdf3d8; color: #b7900d; border: 1px solid #f1c40f; }
    
    /* Pet Cards */
    .pet-card {
        border: 2px solid #f5f5f5;
        border-radius: 14px;
        transition: all 0.2s;
        position: relative;
        overflow: hidden;
    }
    .pet-card:hover { border-color: #f1c40f; box-shadow: 0 6px 20px rgba(241,196,15,0.15); transform: translateY(-3px); }
    .pet-card.deceased { filter: grayscale(100%); opacity: 0.8; }
    .pet-icon { font-size: 2.8rem; line-height: 1; }
    
    .pet-tag { font-size: 0.75rem; padding: 3px 8px; border-radius: 6px; font-weight: 600; }
    .tag-danger { background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; }
    .tag-success { background: #dcfce7; color: #16a34a; border: 1px solid #86efac; }
    .tag-warning { background: #fef3c7; color: #d97706; border: 1px solid #fcd34d; }
    .tag-dark { background: #f3f4f6; color: #4b5563; border: 1px solid #d1d5db; }
    
    /* Buttons */
    .btn-gold { background: linear-gradient(135deg, #f1c40f, #f39c12); color: #fff; font-weight: 600; border: none; }
    .btn-gold:hover { filter: brightness(1.08); color: #fff; box-shadow: 0 4px 12px rgba(241,196,15,0.3); }
    .btn-quick-action { width: 100%; text-align: left; padding: 12px 20px; font-weight: 600; border-radius: 10px; margin-bottom: 10px; transition: all 0.2s; }
    
    /* Timeline */
    .timeline { position: relative; padding-left: 30px; border-left: 2px solid #f0f0f0; margin-top: 1rem; }
    .timeline-item { position: relative; margin-bottom: 1.5rem; }
    .timeline-icon { 
        position: absolute; left: -41px; top: 0; width: 20px; height: 20px; 
        border-radius: 50%; background: #fff; border: 2px solid #f39c12; 
    }
    .timeline-date { font-size: 0.85rem; color: #888; font-weight: 600; margin-bottom: 4px; }
    .timeline-content { background: #fcfcfc; padding: 15px; border-radius: 12px; border: 1px solid #f0f0f0; }
    .timeline-content:hover { border-color: #f1c40f55; background: #fff; }
</style>

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Customers" class="text-warning text-decoration-none">Khách hàng</a></li>
        <li class="breadcrumb-item active">@customer.FullName</li>
    </ol>
</nav>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- TRÁI: THÔNG TIN & THÚ CƯNG -->
    <div class="col-lg-8">
        <!-- Profile Header -->
        <div class="profile-card">
            <div class="profile-header-bg d-flex align-items-center gap-4 flex-wrap">
                <div class="avatar-big">@(customer.FullName?.Substring(0,1).ToUpper() ?? "?")</div>
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-3 mb-1">
                        <h3 class="fw-bold mb-0">@customer.FullName</h3>
                        <span class="badge badge-gold rounded-pill px-3 py-1"><i class="bi bi-star-fill me-1"></i> VIP MEMBER</span>
                    </div>
                    <div class="d-flex gap-4 mt-2 flex-wrap">
                        @if (!string.IsNullOrEmpty(customer.Phone)) { <span class="text-secondary"><i class="bi bi-telephone-fill text-warning me-1"></i>@customer.Phone</span> }
                        @if (!string.IsNullOrEmpty(customer.Email)) { <span class="text-secondary"><i class="bi bi-envelope-fill text-warning me-1"></i>@customer.Email</span> }
                    </div>
                </div>
                <div>
                    <a asp-action="EditCustomer" asp-route-id="@customer.Id" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-pencil-square me-1"></i> Sửa
                    </a>
                </div>
            </div>
            <div class="p-4 bg-white" style="border-radius: 0 0 16px 16px;">
                <div class="row text-center g-3">
                    <div class="col-4 border-end">
                        <div class="info-label">Ngày tham gia</div>
                        <div class="fw-bold fs-5">@(customer.CreatedAt.HasValue ? customer.CreatedAt.Value.ToLocalTime().ToString("MMM yyyy") : "—")</div>
                    </div>
                    <div class="col-4 border-end">
                        <div class="info-label">Bác sĩ thường khám</div>
                        <div class="fw-bold fs-5 text-truncate">
                            @{
                                var preferredDoc = appointments.GroupBy(a => a.DoctorName)
                                                               .OrderByDescending(g => g.Count())
                                                               .FirstOrDefault()?.Key;
                                @(preferredDoc ?? "Chưa có")
                            }
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="info-label">Tổng thú cưng</div>
                        <div class="fw-bold fs-5">@pets.Count() bé</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thú cưng (Pet Family) -->
        <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
            <h5 class="fw-bold mb-0">Gia đình Thú cưng (@pets.Count())</h5>
        </div>
        
        @if (!pets.Any())
        {
            <div class="profile-card p-5 text-center text-muted">
                <i class="bi bi-emoji-frown display-4 opacity-25 mb-3 d-block"></i>
                <p>Khách hàng chưa có thú cưng nào.</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var pet in pets)
                {
                    string speciesIcon = pet.Species?.ToLower() switch { "chó" or "dog" => "🐕", "mèo" or "cat" => "🐈", "thỏ" or "rabbit" => "🐇", "hamster" => "🐹", _ => "🐾" };
                    bool isDeceased = pet.IsDeceased;
                    
                    <div class="col-md-6">
                        <div class="profile-card p-3 h-100 pet-card @(isDeceased ? "deceased" : "")" style="margin-bottom:0; cursor: pointer;" onclick="window.location.href='/Receptionist/PetDetail/@pet.Id'">
                            @if(isDeceased) { <div style="position:absolute; top:10px; right:-30px; background:#444; color:white; font-size:0.7rem; font-weight:bold; padding:2px 30px; transform:rotate(45deg);">ĐÃ MẤT</div> }
                            
                            <div class="d-flex gap-3">
                                <div class="pet-icon">@speciesIcon</div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between">
                                        <h5 class="fw-bold mb-0">@pet.Name</h5>
                                        <a asp-action="EditPet" asp-route-id="@pet.Id" class="text-secondary"><i class="bi bi-three-dots"></i></a>
                                    </div>
                                    <div class="text-muted small mb-2">@pet.Breed • @(pet.Gender == 1 ? "Đực" : pet.Gender == 0 ? "Cái" : "—")</div>
                                    
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        @if(pet.Weight.HasValue) { <span class="pet-tag tag-dark"><i class="bi bi-speedometer2"></i> @pet.Weight kg</span> }
                                        @if(pet.Sterilized == true) { <span class="pet-tag tag-success"><i class="bi bi-scissors"></i> Triệt sản</span> }
                                        @if(pet.IsAggressive) { <span class="pet-tag tag-danger"><i class="bi bi-exclamation-triangle-fill"></i> Hung dữ</span> }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Timeline Lịch sử -->
        <h5 class="fw-bold mb-3 mt-5">Lịch sử Khám bệnh & Tương tác</h5>
        <div class="profile-card p-4">
            @if(!appointments.Any())
            {
                <p class="text-muted text-center py-3">Chưa có lịch sử giao dịch nào.</p>
            }
            else
            {
                <div class="timeline">
                    @foreach(var appt in appointments)
                    {
                        var statusColor = appt.Status == "completed" || appt.Status == "ready_to_pay" ? "success" : 
                                          appt.Status == "cancelled" ? "danger" : "warning";
                                          
                        <div class="timeline-item">
                            <div class="timeline-icon bg-@statusColor border-white"></div>
                            <div class="timeline-date">@DateTime.Parse(appt.AppointmentDate).ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                            <div class="timeline-content">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="fw-bold mb-1">@appt.ServiceName - <span class="text-warning">@appt.PetName</span></h6>
                                        <div class="small text-muted mb-2"><i class="bi bi-person-badge"></i> Bs. @appt.DoctorName</div>
                                        <p class="small mb-0"><strong>Triệu chứng:</strong> @appt.Symptom</p>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-@statusColor bg-opacity-10 text-@statusColor mb-2">@appt.Status.ToUpper()</span><br/>
                                        @if(appt.InvoiceTotalAmount > 0)
                                        {
                                            <span class="fw-bold">@string.Format("{0:N0}đ", appt.InvoiceTotalAmount)</span>
                                            @if(appt.InvoiceStatus == "unpaid") { <span class="badge bg-danger ms-1">NỢ</span> }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- PHẢI: ACTIONS & INSIGHTS -->
    <div class="col-lg-4">
        <!-- Quick Actions -->
        <div class="profile-card p-4">
            <h6 class="fw-bold mb-3">Thao tác nhanh</h6>
            <button class="btn btn-gold btn-quick-action text-white" data-bs-toggle="modal" data-bs-target="#appointmentModal">
                <i class="bi bi-calendar-plus-fill me-2"></i> Đặt Lịch Hẹn Mới
            </button>
            <a asp-action="AddPet" asp-route-customerId="@customer.Id" class="btn btn-outline-secondary btn-quick-action">
                <i class="bi bi-plus-circle-fill text-secondary me-2"></i> Thêm Thú Cưng
            </a>
            <button class="btn btn-outline-secondary btn-quick-action">
                <i class="bi bi-receipt me-2 text-secondary"></i> Tạo Hóa Đơn Lẻ
            </button>
        </div>

        <!-- Relationship Insights -->
        <div class="profile-card p-4">
            <h6 class="fw-bold mb-3">Thông tin Tín nhiệm</h6>
            
            @if(Model.UnpaidBalance > 0)
            {
                <div class="alert alert-danger p-3 rounded-3 mb-4 d-flex align-items-center gap-3">
                    <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                    <div>
                        <div class="fw-bold">Nợ chưa thanh toán</div>
                        <div class="fs-5 fw-bolder">@string.Format("{0:N0} ₫", Model.UnpaidBalance)</div>
                    </div>
                </div>
            }

            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-light p-2 rounded-circle text-primary"><i class="bi bi-cash-coin fs-5"></i></div>
                <div>
                    <div class="info-label">Tổng Chi Tiêu</div>
                    <div class="fw-bold text-dark fs-6">@string.Format("{0:N0} ₫", Model.TotalSpent)</div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="bg-light p-2 rounded-circle text-success"><i class="bi bi-check2-circle fs-5"></i></div>
                <div>
                    <div class="info-label">Tổng Ca Khám Thành Công</div>
                    <div class="fw-bold text-dark fs-6">@Model.TotalVisits ca</div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <div class="bg-light p-2 rounded-circle text-danger"><i class="bi bi-x-circle fs-5"></i></div>
                <div>
                    <div class="info-label">Tỉ lệ Bùng lịch / Hủy ngang</div>
                    <div class="fw-bold text-danger fs-6">@Model.NoShowCount lần</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL TIẾP NHẬN KHÁM -->
<div class="modal fade" id="appointmentModal" tabindex="-1" aria-labelledby="appointmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: none;">
            <div class="modal-header" style="background: linear-gradient(135deg, #fdfaf0, #fff); border-bottom: 2px solid #f1c40f44; border-radius: 20px 20px 0 0;">
                <h5 class="modal-title fw-bold text-dark" id="appointmentModalLabel"><i class="bi bi-journal-medical text-warning me-2"></i>Đặt Lịch Hẹn Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="appointmentForm">
                    <input type="hidden" id="customerId" name="CustomerId" value="@customer.Id" />
                    
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Chọn Thú cưng <span class="text-danger">*</span></label>
                            <select class="form-select form-select-lg" id="petId" name="PetId" required style="border-radius: 12px; border-color: #f1c40f88;">
                                <option value="" disabled selected>-- Chọn bé cần khám --</option>
                                @foreach (var p in pets)
                                {
                                    <option value="@p.Id">@p.Name (@p.Species)</option>
                                }
                            </select>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Dịch vụ <span class="text-danger">*</span></label>
                            <select class="form-select form-select-lg" id="serviceId" name="ServiceId" required style="border-radius: 12px; border-color: #f1c40f88;">
                                <option value="" disabled selected>-- Chọn dịch vụ --</option>
                                @foreach (var s in Model.Services)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Bác sĩ phụ trách <span class="text-danger">*</span></label>
                            <select class="form-select" id="doctorId" name="DoctorId" required style="border-radius: 12px;">
                                <option value="" disabled selected>-- Chọn bác sĩ --</option>
                                @foreach (var d in Model.ActiveDoctors)
                                {
                                    <option value="@d.Id">@d.FullName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Thời gian hẹn</label>
                            <input type="datetime-local" class="form-control" id="appointmentDate" name="AppointmentDate" style="border-radius: 12px;" />
                            <small class="text-muted fst-italic">Bỏ trống nếu khám ngay lúc này</small>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Triệu chứng / Lý do khám <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="symptom" name="Symptom" rows="3" required placeholder="Vd: Bỏ ăn 2 ngày nay, nôn mửa..." style="border-radius: 12px;"></textarea>
                        </div>
                        
                        <div class="col-12">
                            <label class="form-label fw-bold">Ghi chú thêm</label>
                            <textarea class="form-control" id="note" name="Note" rows="2" placeholder="Ghi chú thêm cho bác sĩ (nếu có)" style="border-radius: 12px;"></textarea>
                        </div>
                    </div>
                    
                    <div id="appointmentError" class="alert alert-danger mt-3 d-none"></div>
                </form>
            </div>
            <div class="modal-footer" style="border-top: none; padding: 1.5rem;">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-gold rounded-pill px-4" id="btnSubmitAppointment">
                    <i class="bi bi-check2-circle me-1"></i> Tạo Phiếu Khám
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('btnSubmitAppointment').addEventListener('click', async function() {
            const form = document.getElementById('appointmentForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const btn = this;
            const originalContent = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang tạo...';
            btn.disabled = true;
            
            const errorDiv = document.getElementById('appointmentError');
            errorDiv.classList.add('d-none');

            const payload = {
                CustomerId: document.getElementById('customerId').value,
                PetId: parseInt(document.getElementById('petId').value),
                ServiceId: parseInt(document.getElementById('serviceId').value),
                DoctorId: document.getElementById('doctorId').value,
                Symptom: document.getElementById('symptom').value,
                Note: document.getElementById('note').value,
                AppointmentDate: document.getElementById('appointmentDate').value ? document.getElementById('appointmentDate').value : null
            };

            try {
                const response = await fetch('/Receptionist/CreateAppointment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    var modal = bootstrap.Modal.getInstance(document.getElementById('appointmentModal'));
                    modal.hide();
                    window.location.reload(); // Reload trang để cập nhật lịch sử
                } else {
                    errorDiv.innerHTML = result.message;
                    errorDiv.classList.remove('d-none');
                }
            } catch (err) {
                errorDiv.innerHTML = "Lỗi kết nối máy chủ!";
                errorDiv.classList.remove('d-none');
            } finally {
                btn.innerHTML = originalContent;
                btn.disabled = false;
            }
        });
    </script>
}
