@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h4 class="card-title text-primary"><i class="fas fa-user-shield me-2"></i>Tổng quan Quản trị viên</h4>
                <p class="text-muted">Chào mừng <strong>@ViewBag.UserName</strong> (@ViewBag.Email) quay trở lại hệ thống quản trị.</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="card bg-primary text-white mb-4">
            <div class="card-body">
                <h5 class="card-title">Tổng Khách Hàng</h5>
                <h2 class="display-6">150</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white mb-4">
            <div class="card-body">
                <h5 class="card-title">Lịch Hẹn Hôm Nay</h5>
                <h2 class="display-6">24</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white mb-4">
            <div class="card-body">
                <h5 class="card-title">Doanh Thu (Tháng)</h5>
                <h2 class="display-6">45M</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white mb-4">
            <div class="card-body">
                <h5 class="card-title">Nhân Viên</h5>
                <h2 class="display-6">12</h2>
            </div>
        </div>
    </div>
</div>
