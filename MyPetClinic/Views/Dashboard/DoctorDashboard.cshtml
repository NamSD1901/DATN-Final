@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <h4 class="card-title text-success"><i class="fas fa-stethoscope me-2"></i>Trang làm việc Bác Sĩ</h4>
                <p class="text-muted">Bs. <strong>@ViewBag.UserName</strong> - Chúc bạn một ngày làm việc hiệu quả!</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-calendar-check text-primary me-2"></i>Lịch khám hôm nay (Đang chờ)</h5>
            </div>
            <div class="card-body" id="doctor-waiting-list">
                <p class="text-center text-muted my-3"><i class="fas fa-spinner fa-spin"></i> Đang tải danh sách chờ...</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm mb-4 border-success">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-notes-medical me-2"></i>Bệnh án đang xử lý</h5>
            </div>
            <div class="card-body" id="doctor-inprogress-list">
                <p class="text-center text-muted my-3"><i class="fas fa-spinner fa-spin"></i> Đang tải bệnh án...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            loadDoctorQueue();
            // Polling cập nhật danh sách mỗi 15 giây
            setInterval(loadDoctorQueue, 15000);
        });

        function loadDoctorQueue() {
            $.get('/Doctor/GetMyQueue', function (data) {
                const waitingList = $('#doctor-waiting-list');
                const inProgressList = $('#doctor-inprogress-list');
                
                waitingList.empty();
                inProgressList.empty();

                let waitingCount = 0;
                let inProgressCount = 0;

                data.forEach(item => {
                    if (item.status === 'waiting') {
                        waitingCount++;
                        waitingList.append(`
                            <div class="border rounded p-3 mb-3 bg-light position-relative">
                                ${item.isEmergency ? '<span class="badge bg-danger position-absolute top-0 end-0 m-2">CẤP CỨU</span>' : ''}
                                <h6><strong>${item.petName || 'N/A'}</strong> <span class="text-muted">(${item.species})</span></h6>
                                <p class="mb-2 small"><i class="bi bi-person"></i> ${item.customerName || 'Vãng lai'} - Số thẻ: #${item.queueNumber}</p>
                                <button class="btn btn-primary btn-sm w-100" onclick="startTreatment(${item.appointmentId})">
                                    <i class="fas fa-stethoscope"></i> Bắt đầu khám (Gọi vào phòng)
                                </button>
                            </div>
                        `);
                    } else if (item.status === 'in_progress') {
                        inProgressCount++;
                        inProgressList.append(`
                            <div class="border border-success rounded p-3 mb-3 bg-white position-relative shadow-sm">
                                ${item.isEmergency ? '<span class="badge bg-danger position-absolute top-0 end-0 m-2">CẤP CỨU</span>' : ''}
                                <h6 class="text-success"><strong>${item.petName || 'N/A'}</strong> <span class="text-muted">(${item.species})</span></h6>
                                <p class="mb-2 small"><i class="bi bi-person"></i> ${item.customerName || 'Vãng lai'}</p>
                                <button class="btn btn-success w-100" onclick="finishTreatment(${item.appointmentId})">
                                    <i class="fas fa-check-circle"></i> Hoàn tất & Báo thu tiền
                                </button>
                            </div>
                        `);
                    }
                });

                if (waitingCount === 0) waitingList.html('<p class="text-center text-muted my-3">Không có ca khám nào đang chờ.</p>');
                if (inProgressCount === 0) inProgressList.html('<p class="text-center text-muted my-3">Không có bệnh án nào đang mở.</p>');
            });
        }

        function startTreatment(id) {
            $.post('/Doctor/StartTreatment', { appointmentId: id }, function(res) {
                if(res.success) {
                    Swal.fire({
                        toast: true, position: 'top-end', icon: 'success', 
                        title: 'Đã chuyển trạng thái sang Đang Khám', showConfirmButton: false, timer: 2000
                    });
                    loadDoctorQueue();
                }
            });
        }

        function finishTreatment(id) {
            Swal.fire({
                title: 'Xác nhận hoàn tất?',
                text: "Thẻ bệnh nhân sẽ tự động chuyển sang cột Chờ thanh toán tại quầy Lễ tân.",
                icon: 'info',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Doctor/FinishTreatment', { appointmentId: id }, function(res) {
                        if(res.success) {
                            Swal.fire('Thành công', 'Đã báo thu tiền.', 'success');
                            loadDoctorQueue();
                        }
                    });
                }
            });
        }
    </script>
}
