@{
    ViewData["Title"] = "Lễ Tân - Command Center";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- Omni Search Bar -->
<div class="row mb-4 position-relative z-3">
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-4" style="background: linear-gradient(135deg, #fdfaf0, #ffffff);">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="flex-grow-1 position-relative">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white border-end-0 rounded-start-4 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="omniSearchInput" class="form-control border-start-0 rounded-end-4 shadow-none" placeholder="Tìm kiếm nhanh Khách hàng, Số điện thoại, Mã Microchip hoặc Tên thú cưng..." autocomplete="off">
                    </div>
                    <!-- Dropdown Results -->
                    <div id="omniSearchResults" class="position-absolute w-100 bg-white shadow-lg rounded-4 mt-2 d-none" style="max-height: 400px; overflow-y: auto; z-index: 1050; border: 1px solid #eee;">
                        <!-- Results will be injected here via JS -->
                    </div>
                </div>
                <button class="btn btn-primary btn-lg rounded-4 fw-bold px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#walkInModal">
                    <i class="bi bi-plus-circle me-2"></i> Tạo Walk-in
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Kanban Board -->
<div class="kanban-board">
    <!-- Cột 1: Waiting -->
    <div class="kanban-wrapper">
        <div class="kanban-column rounded-4 p-3 shadow-sm" style="background-color: #f8f9fa; border-top: 4px solid #6c757d; min-height: 70vh;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-secondary mb-0 text-uppercase"><i class="bi bi-hourglass-split me-2"></i> Đang chờ</h6>
                <span class="badge bg-secondary rounded-pill" id="count-waiting">0</span>
            </div>
            <div id="kanban-waiting" class="kanban-list" data-status="waiting" style="min-height: 100px;">
                <!-- Cards here -->
            </div>
        </div>
    </div>

    <!-- Cột 2: In Progress -->
    <div class="kanban-wrapper">
        <div class="kanban-column rounded-4 p-3 shadow-sm" style="background-color: #fff8e1; border-top: 4px solid #ffc107; min-height: 70vh;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-warning mb-0 text-uppercase"><i class="bi bi-activity me-2"></i> Đang khám</h6>
                <span class="badge bg-warning text-dark rounded-pill" id="count-in_progress">0</span>
            </div>
            <div id="kanban-in_progress" class="kanban-list" data-status="in_progress" style="min-height: 100px;">
                <!-- Cards here -->
            </div>
        </div>
    </div>

    <!-- Cột 3: Ready To Pay -->
    <div class="kanban-wrapper">
        <div class="kanban-column rounded-4 p-3 shadow-sm" style="background-color: #e8f5e9; border-top: 4px solid #28a745; min-height: 70vh;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-success mb-0 text-uppercase"><i class="bi bi-cash-coin me-2"></i> Chờ thanh toán</h6>
                <span class="badge bg-success rounded-pill" id="count-ready_to_pay">0</span>
            </div>
            <div id="kanban-ready_to_pay" class="kanban-list" data-status="ready_to_pay" style="min-height: 100px;">
                <!-- Cards here -->
            </div>
        </div>
    </div>
</div>

<!-- Walk-in Modal -->
<div class="modal fade" id="walkInModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-primary text-white rounded-top-4 border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-lightning-charge-fill me-2 text-warning"></i> Tạo ca khám khẩn / Khách vãng lai</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="walkInForm">
                    <div class="row g-4">
                        <!-- Cột Thông tin Khách hàng -->
                        <div class="col-md-6 border-end pe-4">
                            <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">1. Thông tin Khách hàng</h6>
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold">Số điện thoại *</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                    <input type="text" class="form-control" name="Phone" id="walkInPhone" required placeholder="Nhập SĐT để tự nhận diện...">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold">Họ và tên *</label>
                                <input type="text" class="form-control" name="FullName" id="walkInFullName" required>
                                <div id="walkInCustomerStatus" class="form-text text-success d-none"><i class="bi bi-check-circle-fill"></i> Đã tìm thấy khách hàng cũ</div>
                            </div>
                        </div>

                        <!-- Cột Thông tin Thú cưng & Ca khám -->
                        <div class="col-md-6 ps-4">
                            <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">2. Bệnh nhi & Dịch vụ</h6>
                            <div class="row mb-3">
                                <div class="col-7">
                                    <label class="form-label text-muted small fw-bold">Thú cưng *</label>
                                    <div id="petInputWrapper">
                                        <input type="text" class="form-control" name="PetName" id="walkInPetName" required placeholder="Nhập tên bé...">
                                    </div>
                                    <a href="javascript:void(0)" id="btnToggleNewPet" class="small text-decoration-none d-none mt-1"><i class="bi bi-plus-circle"></i> Bé này là thú cưng mới</a>
                                </div>
                                <div class="col-5">
                                    <label class="form-label text-muted small fw-bold">Loài</label>
                                    <select class="form-select" name="Species" id="walkInSpecies">
                                        <option value="Chó">Chó</option>
                                        <option value="Mèo">Mèo</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold">Bác sĩ chỉ định *</label>
                                <select class="form-select" name="DoctorId" id="doctorSelect" required>
                                    <!-- Sẽ load qua JS -->
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted small fw-bold">Triệu chứng ban đầu</label>
                                <textarea class="form-control" name="Symptom" rows="2" placeholder="VD: Bỏ ăn, nôn mửa..."></textarea>
                            </div>

                            <div class="form-check form-switch mt-3">
                                <input class="form-check-input" type="checkbox" role="switch" name="IsEmergency" id="flexSwitchEmergency" value="true">
                                <label class="form-check-label text-danger fw-bold" for="flexSwitchEmergency">
                                    Đánh dấu Cấp cứu (Ưu tiên khám ngay!)
                                </label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 bg-light rounded-bottom-4 p-3">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm" id="btnSubmitWalkIn">Tạo Ca Khám</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Thư viện Kéo Thả (SortableJS) -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <!-- SweetAlert2 cho thông báo mượt mà -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            
            // 1. Khởi tạo Kanban Boards với SortableJS
            const kanbanConfig = {
                group: 'kanban',
                animation: 150,
                ghostClass: 'kanban-card-ghost',
                chosenClass: 'kanban-card-chosen',
                dragClass: 'kanban-card-drag',
                onEnd: function (evt) {
                    const itemEl = evt.item;  // Thẻ vừa kéo
                    const toList = evt.to;    // Danh sách đích
                    
                    const appointmentId = itemEl.getAttribute('data-id');
                    const newStatus = toList.getAttribute('data-status');
                    
                    // Nếu không đổi cột thì thôi
                    if (evt.from === toList) return;

                    // Gọi API cập nhật Status
                    updateStatusAPI(appointmentId, newStatus, evt);
                }
            };

            new Sortable(document.getElementById('kanban-waiting'), kanbanConfig);
            new Sortable(document.getElementById('kanban-in_progress'), kanbanConfig);
            new Sortable(document.getElementById('kanban-ready_to_pay'), kanbanConfig);

            // Hàm Load danh sách Queue ban đầu
            function loadQueue() {
                $.get('/Receptionist/GetTodayQueue', function (data) {
                    // Xóa rỗng các cột
                    $('.kanban-list').empty();
                    
                    let counts = { waiting: 0, in_progress: 0, ready_to_pay: 0 };

                    data.forEach(item => {
                        counts[item.status]++;
                        
                        const emergencyBadge = item.isEmergency 
                            ? `<span class="badge bg-danger mb-2"><i class="bi bi-exclamation-triangle-fill"></i> CẤP CỨU</span>` : '';
                        
                        const aggressiveBadge = item.isAggressive 
                            ? `<span class="badge bg-dark mb-2 ms-1"><i class="bi bi-shield-slash-fill"></i> HUNG DỮ</span>` : '';
                            
                        const timeStr = item.checkInTime ? new Date(item.checkInTime).toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'}) : '';

                        const cardHtml = `
                            <div class="card kanban-card mb-3 shadow-sm border-0 rounded-3" data-id="${item.appointmentId}">
                                <div class="card-body p-3">
                                    ${emergencyBadge} ${aggressiveBadge}
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="card-title fw-bold text-dark mb-0">${item.petName || 'Không tên'} <span class="text-muted small fw-normal">(${item.species || 'Pet'})</span></h6>
                                        <span class="badge bg-light text-secondary border border-secondary">#${item.queueNumber}</span>
                                    </div>
                                    <p class="card-text text-muted small mb-2"><i class="bi bi-person-fill me-1"></i> Khách: ${item.customerName || 'Vãng lai'}</p>
                                    <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                        <div class="small text-muted"><i class="bi bi-clock me-1"></i> ${timeStr}</div>
                                        <div class="small fw-bold text-primary" title="Bác sĩ phụ trách"><i class="bi bi-heart-pulse me-1"></i> Bs. ${item.doctorName?.split(' ').pop() || 'N/A'}</div>
                                    </div>
                                </div>
                            </div>
                        `;
                        
                        $(`#kanban-${item.status}`).append(cardHtml);
                    });

                    // Cập nhật số lượng
                    $('#count-waiting').text(counts.waiting);
                    $('#count-in_progress').text(counts.in_progress);
                    $('#count-ready_to_pay').text(counts.ready_to_pay);
                });
            }

            // Gọi API Update Status
            function updateStatusAPI(id, newStatus, evt) {
                $.post('/Receptionist/UpdateQueueStatus', { appointmentId: id, status: newStatus }, function(res) {
                    if(res.success) {
                        const Toast = Swal.mixin({
                            toast: true,
                            position: "top-end",
                            showConfirmButton: false,
                            timer: 2000,
                            timerProgressBar: true,
                        });
                        Toast.fire({ icon: "success", title: "Đã chuyển trạng thái!" });
                        
                        // Cập nhật lại số đếm thủ công hoặc gọi loadQueue()
                        loadQueue();
                    } else {
                        Swal.fire('Lỗi!', 'Không thể cập nhật trạng thái.', 'error');
                        // Hoàn tác kéo thả
                        evt.from.appendChild(evt.item);
                    }
                });
            }

            // Khởi chạy load ban đầu
            loadQueue();
            // Có thể dùng setInterval(loadQueue, 15000); để polling realtime nếu ko dùng SignalR

            // 2. Logic OmniSearch
            let searchTimeout;
            $('#omniSearchInput').on('input', function() {
                const query = $(this).val();
                clearTimeout(searchTimeout);
                
                if (query.length < 2) {
                    $('#omniSearchResults').addClass('d-none').empty();
                    return;
                }

                searchTimeout = setTimeout(function() {
                    $.get('/Receptionist/OmniSearch', { q: query }, function(data) {
                        const resultsBox = $('#omniSearchResults');
                        resultsBox.empty();

                        if (data.length === 0) {
                            resultsBox.append('<div class="p-3 text-center text-muted">Không tìm thấy kết quả nào.</div>');
                        } else {
                            data.forEach(user => {
                                let petsHtml = '';
                                user.pets.forEach(pet => {
                                    petsHtml += `
                                        <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded mt-2">
                                            <div><i class="bi bi-box2-heart text-danger me-2"></i><strong>${pet.name}</strong> (${pet.species})</div>
                                            <button class="btn btn-sm btn-outline-success rounded-pill px-3 btn-checkin" 
                                                data-phone="${user.phone}" 
                                                data-name="${user.fullName}" 
                                                data-pet="${pet.name}" 
                                                data-species="${pet.species}">Check-in ngay</button>
                                        </div>
                                    `;
                                });

                                const userHtml = `
                                    <div class="p-3 border-bottom search-result-item">
                                        <div class="d-flex justify-content-between">
                                            <div class="fw-bold text-dark"><i class="bi bi-person-circle me-2 text-primary"></i> ${user.fullName}</div>
                                            <div class="text-muted small"><i class="bi bi-telephone me-1"></i> ${user.phone}</div>
                                        </div>
                                        <div class="ps-4 mt-1">
                                            ${petsHtml}
                                        </div>
                                    </div>
                                `;
                                resultsBox.append(userHtml);
                            });
                        }
                        resultsBox.removeClass('d-none');
                    });
                }, 400); // Debounce 400ms
            });

            // Ẩn kết quả tìm kiếm khi click ngoài
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#omniSearchInput, #omniSearchResults').length) {
                    $('#omniSearchResults').addClass('d-none');
                }
            });

            // 3. Logic Form Walk-in
            // Load Doctors for dropdown 
            $.get('/Receptionist/GetDoctors', function(res) {
                 const select = $('#doctorSelect');
                 select.empty();
                 if(res.length === 0) {
                     select.append('<option value="">-- Không có bác sĩ --</option>');
                 } else {
                     res.forEach(doc => {
                         select.append(`<option value="${doc.id}">Bs. ${doc.fullName}</option>`);
                     });
                 }
            }).fail(function() {
                 $('#doctorSelect').html('<option value="">Lỗi tải danh sách bác sĩ</option>');
            });

            $('#btnSubmitWalkIn').click(function() {
                const formData = $('#walkInForm').serializeArray();
                const dataObj = {};
                formData.forEach(item => dataObj[item.name] = item.value);
                
                // Set default ServiceId for now since WalkIn is generic emergency
                dataObj.ServiceId = 1; 

                // Nếu IsEmergency ko có trong dataObj (khi checkbox ko check)
                if(!$('#flexSwitchEmergency').is(':checked')) {
                    dataObj.IsEmergency = false;
                }

                $.ajax({
                    url: '/Receptionist/CreateWalkIn',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(dataObj),
                    success: function(res) {
                        if (res.success) {
                            $('#walkInModal').modal('hide');
                            resetWalkInForm();
                            Swal.fire('Thành công', 'Đã xếp vào hàng đợi!', 'success');
                            loadQueue(); // Tải lại bảng
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    }
                });
            });

            // Gắn sự kiện Check-in từ OmniSearch
            $(document).on('click', '.btn-checkin', function() {
                $('#omniSearchResults').addClass('d-none');
                
                const phone = $(this).data('phone');
                const name = $(this).data('name');
                const petName = $(this).data('pet');
                const species = $(this).data('species');
                
                // Mở Modal và fill data
                $('#walkInPhone').val(phone).trigger('blur'); 
                
                // Đợi 1 chút cho blur API chạy xong rồi set giá trị pet
                setTimeout(() => {
                    $('#walkInModal').modal('show');
                    if ($('#walkInPetSelect').length) {
                        $('#walkInPetSelect').val(petName);
                    } else {
                        $('#walkInPetName').val(petName);
                    }
                    $('#walkInSpecies').val(species);
                }, 300);
            });
            
            // --- AUTO FILL LOGIC ---
            $('#walkInPhone').on('blur', function() {
                const phone = $(this).val().trim();
                if (phone.length < 9) return;
                
                $.get('/Receptionist/GetCustomerByPhone', { phone: phone }, function(res) {
                    if(res.success) {
                        $('#walkInFullName').val(res.customer.fullName).prop('readonly', true).addClass('bg-light');
                        $('#walkInCustomerStatus').removeClass('d-none');
                        
                        // Thay đổi ô nhập Pet thành dropdown
                        if(res.pets && res.pets.length > 0) {
                            let options = res.pets.map(p => `<option value="${p.name}" data-species="${p.species}">${p.name} (${p.species})</option>`).join('');
                            $('#petInputWrapper').html(`
                                <select class="form-select border-success" name="PetName" id="walkInPetSelect">
                                    ${options}
                                </select>
                            `);
                            $('#btnToggleNewPet').removeClass('d-none');
                            
                            // Tự động set Species theo pet chọn
                            $('#walkInPetSelect').change(function() {
                                $('#walkInSpecies').val($(this).find(':selected').data('species'));
                            }).trigger('change');
                        }
                    } else {
                        resetCustomerFields();
                    }
                });
            });
            
            $('#btnToggleNewPet').click(function() {
                $('#petInputWrapper').html('<input type="text" class="form-control border-primary" name="PetName" id="walkInPetName" required placeholder="Nhập tên bé...">');
                $(this).addClass('d-none');
            });
            
            function resetCustomerFields() {
                $('#walkInFullName').prop('readonly', false).removeClass('bg-light');
                $('#walkInCustomerStatus').addClass('d-none');
                $('#petInputWrapper').html('<input type="text" class="form-control" name="PetName" id="walkInPetName" required placeholder="Nhập tên bé...">');
                $('#btnToggleNewPet').addClass('d-none');
            }
            
            function resetWalkInForm() {
                $('#walkInForm')[0].reset();
                resetCustomerFields();
            }
            
            $('#walkInModal').on('hidden.bs.modal', function () {
                resetWalkInForm();
            });
        });
    </script>
}
