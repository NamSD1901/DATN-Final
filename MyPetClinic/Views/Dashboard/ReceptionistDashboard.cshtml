@{
    ViewData["Title"] = "Tổng quan Lễ Tân";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="card shadow-sm border-0 rounded-4 p-4 text-center">
            <h4 class="fw-bold text-primary mb-3">Chào mừng bạn đến với Command Center</h4>
            <p class="text-muted mb-4">Chọn các chức năng ở menu bên trái để làm việc.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/Receptionist/Queue" class="btn btn-warning fw-bold px-4 rounded-pill shadow-sm">
                    <i class="bi bi-kanban me-2"></i> Mở Hàng Khám (Kanban)
                </a>
                <a href="/Appointment/Index" class="btn btn-primary fw-bold px-4 rounded-pill shadow-sm">
                    <i class="bi bi-calendar-check me-2"></i> Quản lý Lịch Hẹn
                </a>
            </div>
        </div>
    </div>
</div>
