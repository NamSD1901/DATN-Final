@{
    ViewData["Title"] = "Chi tiết bài viết";
    int articleId = ViewBag.ArticleId ?? 1;
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <a asp-controller="Home" asp-action="Index" fragment="news" class="text-decoration-none text-muted hover-text-warning">
                    <i class="bi bi-arrow-left me-1"></i> Trở về trang chủ
                </a>
            </div>

            @if (articleId == 1)
            {
                <div class="mt-4 mb-3">
                    <span class="badge bg-danger fw-bold text-uppercase me-2">Sức khỏe</span>
                    <span class="badge bg-light text-secondary border fw-normal me-1"><i class="bi bi-tag-fill me-1"></i>Nấm da</span>
                    <span class="badge bg-light text-secondary border fw-normal me-1"><i class="bi bi-tag-fill me-1"></i>Lây nhiễm</span>
                    <span class="badge bg-light text-secondary border fw-normal"><i class="bi bi-tag-fill me-1"></i>Bệnh da liễu</span>
                </div>
                <h1 class="fw-bold mb-3">Nấm da ở chó mèo có lây sang người không?</h1>
                <div class="d-flex align-items-center gap-2 mb-4 text-muted small border-bottom pb-3">
                    <span><i class="bi bi-calendar3 me-1"></i> 25/05/2026</span>
                    <span>•</span>
                    <span><i class="bi bi-person-fill me-1"></i> Bác sĩ MyPetClinic</span>
                </div>
                <img src="https://images.unsplash.com/photo-1596492784531-6e6eb5ea9993?q=80&w=1200&auto=format&fit=crop" class="img-fluid rounded-4 mb-4 w-100 shadow-sm" alt="Nấm da ở chó mèo" />
                
                <div class="article-content text-muted lh-lg fs-5">
                    <p>Nấm da (Ringworm) là một trong những căn bệnh da liễu cực kỳ phổ biến ở chó mèo, đặc biệt là trong môi trường thời tiết nóng ẩm. Triệu chứng dễ nhận biết nhất là thú cưng bị rụng lông thành từng mảng tròn, da mẩn đỏ, có vảy sừng và ngứa ngáy liên tục.</p>
                    <p>Điều đáng lo ngại là bệnh này không chỉ làm thú cưng khó chịu, mất thẩm mỹ mà khả năng lây lan trong môi trường sống là rất cao. Bào tử nấm có thể tồn tại trong nhà, trên thảm, ghế sofa và giường ngủ lên đến 18 tháng nếu không được tiêu diệt hoàn toàn.</p>
                    <h4 class="fw-bold text-dark mt-5 mb-3">Nấm da có lây sang người không?</h4>
                    <p>Câu trả lời là <strong>CÓ</strong>. Nấm da là một bệnh truyền nhiễm có thể lây từ động vật sang người thông qua tiếp xúc trực tiếp hoặc gián tiếp qua đồ dùng (chăn nệm, lược chải lông). Trẻ em, người lớn tuổi, hoặc những người có hệ miễn dịch yếu là nhóm đối tượng có nguy cơ lây nhiễm cao nhất. Khi bị lây, người bệnh sẽ xuất hiện các đốm đỏ hình tròn, ngứa ngáy dữ dội.</p>
                    <h4 class="fw-bold text-dark mt-5 mb-3">Cách phòng ngừa và điều trị hiệu quả</h4>
                    <ul class="mb-4">
                        <li class="mb-2"><strong>Cách ly ngay lập tức:</strong> Tách thú cưng bị bệnh khỏi trẻ em và các vật nuôi khác trong nhà.</li>
                        <li class="mb-2"><strong>Khám thú y:</strong> Đưa bé đến phòng khám thú y để được bác sĩ lấy mẫu xét nghiệm, soi đèn mộc nhĩ và kê đơn thuốc bôi/uống (thuốc kháng nấm) phù hợp.</li>
                        <li class="mb-2"><strong>Vệ sinh môi trường:</strong> Giặt giũ toàn bộ chăn, nệm, đồ chơi của thú cưng bằng nước nóng. Lau nhà bằng dung dịch sát khuẩn chuyên dụng.</li>
                        <li class="mb-2"><strong>Tắm rửa định kỳ:</strong> Sử dụng sữa tắm trị nấm chuyên dụng theo chỉ định (thường 1-2 lần/tuần).</li>
                    </ul>
                    <div class="bg-light p-4 rounded-3 border-start border-warning border-5">
                        <p class="mb-0"><i>Lưu ý quan trọng: Tuyệt đối không tự ý mua các loại thuốc bôi da của người hoặc các loại lá dân gian để bôi cho thú cưng nếu chưa có sự chỉ định của bác sĩ thú y để tránh tình trạng bệnh nặng hơn hoặc ngộ độc thuốc do thú cưng liếm phải.</i></p>
                    </div>
                </div>
            }
            else if (articleId == 2)
            {
                <div class="mt-4 mb-3">
                    <span class="badge bg-warning text-dark fw-bold text-uppercase me-2">Kinh nghiệm</span>
                    <span class="badge bg-light text-secondary border fw-normal me-1"><i class="bi bi-tag-fill me-1"></i>Rụng lông</span>
                    <span class="badge bg-light text-secondary border fw-normal me-1"><i class="bi bi-tag-fill me-1"></i>Kinh nghiệm</span>
                    <span class="badge bg-light text-secondary border fw-normal"><i class="bi bi-tag-fill me-1"></i>Chăm sóc chó</span>
                </div>
                <h1 class="fw-bold mb-3">Tại sao chó bị rụng lông và cách điều trị hiệu quả</h1>
                <div class="d-flex align-items-center gap-2 mb-4 text-muted small border-bottom pb-3">
                    <span><i class="bi bi-calendar3 me-1"></i> 24/05/2026</span>
                    <span>•</span>
                    <span><i class="bi bi-person-fill me-1"></i> Bác sĩ MyPetClinic</span>
                </div>
                <img src="https://images.unsplash.com/photo-1581888227599-779811939961?q=80&w=1200&auto=format&fit=crop" class="img-fluid rounded-4 mb-4 w-100 shadow-sm" alt="Chó bị rụng lông" />
                
                <div class="article-content text-muted lh-lg fs-5">
                    <p>Rụng lông ở chó là một hiện tượng sinh lý bình thường diễn ra theo chu kỳ (thường là vào mùa xuân và mùa thu). Tuy nhiên, nếu lượng lông rụng quá nhiều, rụng thành từng mảng lộ cả da non, kèm theo các triệu chứng như ngứa ngáy, gãi liên tục, lở loét hoặc da có mùi hôi, thì đó có thể là dấu hiệu cảnh báo vấn đề sức khỏe.</p>
                    <p>Ngoài hiện tượng sinh lý, tình trạng stress, mang thai hoặc thay đổi môi trường sống đột ngột cũng có thể làm cho chó bị căng thẳng, dẫn đến rụng lông trên diện rộng.</p>
                    <h4 class="fw-bold text-dark mt-5 mb-3">Các nguyên nhân y khoa phổ biến</h4>
                    <ul class="mb-4">
                        <li class="mb-2"><strong>Thiếu hụt dinh dưỡng:</strong> Chế độ ăn nghèo nàn, thiếu protein, vitamin (đặc biệt là Biotin, Vitamin E) và khoáng chất thiết yếu.</li>
                        <li class="mb-2"><strong>Nhiễm ký sinh trùng:</strong> Ve, rận, bọ chét hoặc bệnh ghẻ Demodex/Sarcoptes phá hủy nang lông.</li>
                        <li class="mb-2"><strong>Dị ứng:</strong> Dị ứng với thành phần thức ăn (như gà, bò), thời tiết, hoặc các sản phẩm sữa tắm hóa chất mạnh không phù hợp.</li>
                        <li class="mb-2"><strong>Rối loạn nội tiết:</strong> Hội chứng Cushing hoặc suy giáp cũng là nguyên nhân gây rụng lông mất kiểm soát.</li>
                    </ul>
                    <h4 class="fw-bold text-dark mt-5 mb-3">Giải pháp khắc phục và chăm sóc</h4>
                    <p>Bổ sung ngay các loại thực phẩm giàu Omega 3-6 (như dầu cá hồi, hạt lanh, dầu dừa) vào khẩu phần ăn hàng ngày để nuôi dưỡng da lông từ bên trong. Thường xuyên chải lông để loại bỏ lông rụng và massage kích thích nang lông phát triển.</p>
                    <div class="bg-light p-4 rounded-3 border-start border-warning border-5">
                        <p class="mb-0 text-danger fw-bold">Nếu chó gãi nhiều, da ửng đỏ, có vảy hoặc chảy dịch, hãy đặt lịch khám tại MyPetClinic để bác sĩ kiểm tra chuyên sâu, soi da và có phác đồ điều trị kịp thời.</p>
                    </div>
                </div>
            }
            else if (articleId == 3)
            {
                <div class="mt-4 mb-3">
                    <span class="badge bg-info fw-bold text-uppercase me-2">Dinh dưỡng</span>
                    <span class="badge bg-light text-secondary border fw-normal me-1"><i class="bi bi-tag-fill me-1"></i>Táo bón</span>
                    <span class="badge bg-light text-secondary border fw-normal me-1"><i class="bi bi-tag-fill me-1"></i>Tiêu hóa</span>
                    <span class="badge bg-light text-secondary border fw-normal"><i class="bi bi-tag-fill me-1"></i>Dinh dưỡng</span>
                </div>
                <h1 class="fw-bold mb-3">Chó bị táo bón: Biểu hiện và cách điều trị tại nhà</h1>
                <div class="d-flex align-items-center gap-2 mb-4 text-muted small border-bottom pb-3">
                    <span><i class="bi bi-calendar3 me-1"></i> 20/05/2026</span>
                    <span>•</span>
                    <span><i class="bi bi-person-fill me-1"></i> Bác sĩ MyPetClinic</span>
                </div>
                <img src="https://images.unsplash.com/photo-1544568100-847a948585b9?q=80&w=1200&auto=format&fit=crop" class="img-fluid rounded-4 mb-4 w-100 shadow-sm" alt="Chó bị táo bón" />
                
                <div class="article-content text-muted lh-lg fs-5">
                    <p>Táo bón là một trong những vấn đề tiêu hóa thường gặp nhất ở chó. Mặc dù không phải là bệnh nan y, nhưng nếu để kéo dài có thể gây ra hiện tượng phình đại tràng, tổn thương niêm mạc ruột, hấp thu ngược độc tố và làm thú cưng suy nhược cơ thể nghiêm trọng.</p>
                    <p>Nguyên nhân gây táo bón rất đa dạng: từ việc chế độ ăn quá nghèo nàn chất xơ, ăn quá nhiều xương cứng (đặc biệt là xương ống, xương cổ gà), thói quen uống ít nước, cho đến các vấn đề bệnh lý về tuyến hậu môn hoặc khối u trong đường ruột.</p>
                    <h4 class="fw-bold text-dark mt-5 mb-3">Dấu hiệu nhận biết rõ ràng</h4>
                    <ul class="mb-4">
                        <li class="mb-2">Chó đi vệ sinh rặn nhiều lần nhưng không ra phân, rên rỉ vì đau đớn.</li>
                        <li class="mb-2">Phân rất cứng, nhỏ, khô và có thể lẫn một chút máu do nứt kẽ hậu môn.</li>
                        <li class="mb-2">Bụng phình to, căng cứng, sờ vào thấy cứng và có biểu hiện cắn lại khi bị chạm vào.</li>
                        <li class="mb-2">Chó lờ đờ, chán ăn, thỉnh thoảng nôn mửa do thức ăn và dịch dạ dày bị ứ đọng không tiêu thoát được.</li>
                    </ul>
                    <h4 class="fw-bold text-dark mt-5 mb-3">Chăm sóc và xử lý tại nhà an toàn</h4>
                    <p>Điều đầu tiên cần làm là cung cấp đủ nước sạch, hoặc pha thêm chút mật ong/nước luộc gà để kích thích chó uống nhiều nước hơn. Bạn có thể trộn thêm một chút men tiêu hóa hoặc bí đỏ luộc nghiền nhuyễn (rất giàu chất xơ hòa tan) vào thức ăn mềm để giúp nhuận tràng.</p>
                    <p>Nên ngừng hẳn việc cho chó ăn xương cứng trong giai đoạn này. Khuyến khích chó vận động chạy nhảy nhẹ nhàng từ 15-20 phút mỗi ngày để kích thích nhu động ruột hoạt động tự nhiên trở lại.</p>
                    <div class="bg-light p-4 rounded-3 border-start border-danger border-5">
                        <p class="mb-0 text-danger fw-bold">Tuyệt đối không tự ý dùng thuốc thụt tháo của người cho chó. Nếu tình trạng táo bón kéo dài quá 2-3 ngày, vui lòng đưa cún cưng đến MyPetClinic ngay lập tức để bác sĩ can thiệp y tế (thụt tháo chuyên dụng hoặc siêu âm kiểm tra dị vật/khối u).</p>
                    </div>
                </div>
            }

            <!-- Gợi ý bài viết mới -->
            <div class="mt-5 pt-5 border-top">
                <h4 class="fw-bold mb-4"><i class="bi bi-stars text-warning me-2"></i>Có thể bạn quan tâm</h4>
                <div class="row g-4">
                    @if (articleId != 1)
                    {
                        <div class="col-md-6">
                            <a asp-controller="Home" asp-action="Article" asp-route-id="1" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 hover-shadow transition-all">
                                    <div class="row g-0 h-100">
                                        <div class="col-4">
                                            <img src="https://images.unsplash.com/photo-1596492784531-6e6eb5ea9993?q=80&w=300&auto=format&fit=crop" class="img-fluid rounded-start h-100" style="object-fit: cover;" alt="Nấm da">
                                        </div>
                                        <div class="col-8">
                                            <div class="card-body py-2 px-3">
                                                <h6 class="card-title fw-bold text-dark mb-1 lh-sm hover-text-warning">Nấm da ở chó mèo lây sang người?</h6>
                                                <small class="text-muted"><i class="bi bi-clock me-1"></i>3 phút đọc</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                    @if (articleId != 2)
                    {
                        <div class="col-md-6">
                            <a asp-controller="Home" asp-action="Article" asp-route-id="2" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 hover-shadow transition-all">
                                    <div class="row g-0 h-100">
                                        <div class="col-4">
                                            <img src="https://images.unsplash.com/photo-1581888227599-779811939961?q=80&w=300&auto=format&fit=crop" class="img-fluid rounded-start h-100" style="object-fit: cover;" alt="Rụng lông">
                                        </div>
                                        <div class="col-8">
                                            <div class="card-body py-2 px-3">
                                                <h6 class="card-title fw-bold text-dark mb-1 lh-sm hover-text-warning">Tại sao chó bị rụng lông nhiều?</h6>
                                                <small class="text-muted"><i class="bi bi-clock me-1"></i>3 phút đọc</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                    @if (articleId != 3)
                    {
                        <div class="col-md-6">
                            <a asp-controller="Home" asp-action="Article" asp-route-id="3" class="text-decoration-none">
                                <div class="card border-0 shadow-sm h-100 hover-shadow transition-all">
                                    <div class="row g-0 h-100">
                                        <div class="col-4">
                                            <img src="https://images.unsplash.com/photo-1544568100-847a948585b9?q=80&w=300&auto=format&fit=crop" class="img-fluid rounded-start h-100" style="object-fit: cover;" alt="Táo bón">
                                        </div>
                                        <div class="col-8">
                                            <div class="card-body py-2 px-3">
                                                <h6 class="card-title fw-bold text-dark mb-1 lh-sm hover-text-warning">Chó bị táo bón: Biểu hiện và xử lý</h6>
                                                <small class="text-muted"><i class="bi bi-clock me-1"></i>4 phút đọc</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
