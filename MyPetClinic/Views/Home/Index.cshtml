@{
    ViewData["Title"] = "Trang Chủ - Bệnh Viện Thú Y MyPetClinic";
}

<!-- Hero Section with Floating Shapes -->
<section class="hero-section bg-gold-gradient position-relative">
    <div class="hero-shape-1"></div>
    <div class="hero-shape-2"></div>
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 text-center text-lg-start reveal-left">
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm text-uppercase">
                    <i class="bi bi-heart-fill text-danger me-1"></i> Bệnh Viện Thú Y Uy Tín Hàng Đầu
                </span>
                <h1 class="display-3 fw-bold mb-4 gradient-text-gold leading-tight">
                    CHĂM SÓC THÚ CƯNG<br />NHƯ BẠN THÂN
                </h1>
                <p class="fs-5 text-muted mb-5">
                    Tại <strong class="text-dark">MyPetClinic</strong>, chúng tôi hiểu rằng thú cưng là thành viên vô giá trong gia đình bạn. Với đội ngũ bác sĩ thú y giàu y đức, tay nghề cao cùng trang thiết bị hiện đại chuẩn quốc tế, chúng tôi cam kết mang lại dịch vụ chăm sóc sức khỏe tốt nhất.
                </p>
                <div class="d-flex flex-column flex-sm-row justify-content-center justify-content-lg-start gap-3">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <button class="btn btn-premium btn-lg shadow" type="button" data-bs-toggle="modal" data-bs-target="#contactAdviceModal">
                            <i class="bi bi-calendar-check me-2"></i>Đặt Lịch Ngay
                        </button>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-premium btn-lg shadow">
                            <i class="bi bi-calendar-check me-2"></i>Đặt Lịch Ngay
                        </a>
                    }
                    <a href="#services" class="btn btn-premium-outline btn-lg">
                        Tìm Hiểu Dịch Vụ <i class="bi bi-arrow-down-circle ms-2"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center reveal-right">
                <!-- Premium illustrative pet banner -->
                <div class="position-relative d-inline-block">
                    <div class="bg-white rounded-circle shadow-lg p-3 position-absolute start-0 top-0 animate-bounce" style="width: 80px; height: 80px; z-index: 10;">
                        <i class="bi bi-chat-heart-fill text-warning fs-1"></i>
                    </div>
                    <img src="https://images.unsplash.com/photo-1583511655857-d19b40a7a54e?q=80&w=600&auto=format&fit=crop" class="img-fluid rounded-circle border border-5 border-white shadow-2xl hover-scale transition-all duration-500" alt="Pet Clinic Welcome Image" style="width: 450px; height: 450px; object-fit: cover;" />
                    <div class="bg-warning text-dark rounded-4 shadow-lg p-3 position-absolute end-0 bottom-0 text-start" style="width: 220px; border-left: 5px solid var(--primary-dark);">
                        <h6 class="fw-bold mb-1"><i class="bi bi-clock-fill me-1"></i> Giờ Hành Chính</h6>
                        <p class="mb-0 fs-7 text-dark-50">Đội ngũ bác sĩ luôn sẵn sàng phục vụ bé cưng trong khung giờ làm việc.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Section inspired by petcare.vn introduction -->
<section class="py-5 bg-white border-bottom" id="intro">
    <div class="container my-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 order-2 order-lg-1 reveal-left">
                <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?q=80&w=600&auto=format&fit=crop" class="img-fluid rounded-4 shadow-lg" alt="Veterinarian Examining Dog" />
            </div>
            <div class="col-lg-6 order-1 order-lg-2 reveal-right">
                <h6 class="text-warning fw-bold text-uppercase tracking-wider mb-2">Về Chúng Tôi</h6>
                <h2 class="fw-bold mb-4">Nơi Gửi Gắm Niềm Tin Của Hàng Triệu Chủ Nuôi</h2>
                <p class="text-muted mb-4">
                    Thành lập từ khát khao nâng cao chất lượng phúc lợi cho động vật tại Việt Nam, <strong>MyPetClinic</strong> đã không ngừng đổi mới và nâng cao năng lực y tế. Chúng tôi tin rằng mỗi thú cưng xứng đáng nhận được dịch vụ chăm sóc y tế chuyên nghiệp, nhân văn nhất.
                </p>
                <div class="row g-3">
                    <div class="col-md-6 d-flex align-items-start gap-3">
                        <div class="bg-warning bg-opacity-25 text-warning p-2 rounded-3">
                            <i class="bi bi-award-fill fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Bác sĩ chuyên khoa</h6>
                            <p class="small text-muted mb-0">Hơn 15 năm kinh nghiệm thực chiến y khoa.</p>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex align-items-start gap-3">
                        <div class="bg-warning bg-opacity-25 text-warning p-2 rounded-3">
                            <i class="bi bi-hospital fs-4"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Thiết bị hiện đại</h6>
                            <p class="small text-muted mb-0">Hệ thống chẩn đoán hình ảnh cao cấp nhập khẩu.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Core Services Section -->
<section class="py-5" id="services">
    <div class="container my-4 text-center reveal">
        <h6 class="text-warning fw-bold text-uppercase tracking-wider mb-2">Dịch Vụ Của Chúng Tôi</h6>
        <h2 class="fw-bold mb-2">Giải Pháp Chăm Sóc Toàn Diện Cho Thú Cưng</h2>
        <p class="text-muted max-w-2xl mx-auto mb-5">
            Chúng tôi cung cấp đầy đủ các danh mục dịch vụ từ y tế dự phòng, xét nghiệm chẩn đoán nâng cao cho đến các liệu trình phẫu thuật chuyên sâu và làm đẹp thẩm mỹ.
        </p>

        <div class="row g-4 text-start">
            <!-- Service 1 -->
            <div class="col-md-6 col-lg-3 reveal delay-100">
                <div class="card border-0 glass-card h-100 p-4">
                    <div class="bg-info bg-opacity-10 text-info rounded-4 d-inline-flex align-items-center justify-content-center mb-4 shadow-sm" style="width: 60px; height: 60px;">
                        <i class="bi bi-patch-check fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Tiêm Phòng Bệnh</h5>
                    <p class="small text-muted mb-0">
                        Tiêm phòng vaccine và phòng chống ký sinh trùng định kỳ theo phác đồ khoa học giúp phòng ngừa tối đa bệnh tật.
                    </p>
                </div>
            </div>

            <!-- Service 2 -->
            <div class="col-md-6 col-lg-3 reveal delay-200">
                <div class="card border-0 glass-card h-100 p-4">
                    <div class="bg-warning bg-opacity-15 text-warning rounded-4 d-inline-flex align-items-center justify-content-center mb-4 shadow-sm" style="width: 60px; height: 60px;">
                        <i class="bi bi-heart-pulse fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Khám & Điều Trị</h5>
                    <p class="small text-muted mb-0">
                        Thăm khám tổng quát, tư vấn chế độ dinh dưỡng, chẩn đoán lâm sàng chuẩn xác các bệnh nội khoa phức tạp.
                    </p>
                </div>
            </div>

            <!-- Service 3 -->
            <div class="col-md-6 col-lg-3 reveal delay-300">
                <div class="card border-0 glass-card h-100 p-4">
                    <div class="bg-success bg-opacity-10 text-success rounded-4 d-inline-flex align-items-center justify-content-center mb-4 shadow-sm" style="width: 60px; height: 60px;">
                        <i class="bi bi-activity fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Phẫu Thuật Ngoại</h5>
                    <p class="small text-muted mb-0">
                        Phòng mổ vô trùng áp lực dương tuyệt đối. Thực hiện các ca phẫu thuật triệt sản, mổ đẻ hay nối xương phức tạp.
                    </p>
                </div>
            </div>

            <!-- Service 4 -->
            <div class="col-md-6 col-lg-3 reveal delay-400">
                <div class="card border-0 glass-card h-100 p-4">
                    <div class="bg-info bg-opacity-10 text-info rounded-4 d-inline-flex align-items-center justify-content-center mb-4 shadow-sm" style="width: 60px; height: 60px;">
                        <i class="bi bi-scissors fs-3"></i>
                    </div>
                    <h5 class="fw-bold mb-2">Spa & Làm Đẹp</h5>
                    <p class="small text-muted mb-0">
                        Cắt tỉa lông tạo kiểu nghệ thuật, tắm sấy khử mùi, vắt tuyến hôi và vệ sinh tai móng chuyên nghiệp từ các chuyên gia Grooming.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Useful Knowledge & Blog Section -->
<section class="py-5 bg-white border-top border-bottom" id="news">
    <div class="container my-4">
        <div class="text-center mb-5 reveal">
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2 shadow-sm text-uppercase">
                <i class="bi bi-journal-bookmark-fill me-1"></i> Góc Chia Sẻ
            </span>
            <h2 class="fw-bold mb-2">Cẩm Nang Sức Khỏe & Tin Tức Thú Cưng</h2>
            <p class="text-muted max-w-2xl mx-auto">
                Cập nhật những thông tin quan trọng, kiến thức chăm sóc khoa học từ đội ngũ bác sĩ y khoa MyPetClinic.
            </p>
        </div>

        <div class="row g-4">
            <!-- Article 1 -->
            <div class="col-md-6 col-lg-4 reveal delay-100">
                <div class="card border-0 glass-card h-100 overflow-hidden shadow-sm">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1596492784531-6e6eb5ea9993?q=80&w=400&auto=format&fit=crop" class="card-img-top" alt="Nấm da ở chó mèo" style="height: 220px; object-fit: cover;" />
                        <span class="position-absolute top-0 start-0 m-3 badge bg-danger fw-bold text-uppercase">Sức khỏe</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-2 mb-2 text-muted small">
                            <span><i class="bi bi-calendar3 me-1"></i> 25/05/2026</span>
                            <span>•</span>
                            <span><i class="bi bi-person-fill me-1"></i> Bác sĩ MyPetClinic</span>
                        </div>
                        <h5 class="card-title fw-bold mb-2">
                            <a href="#" data-bs-toggle="modal" data-bs-target="#articleModal1" class="text-decoration-none text-dark hover-text-warning">
                                Nấm da ở chó mèo có lây sang người không?
                            </a>
                        </h5>
                        <div class="mb-3">
                            <span class="badge bg-light text-secondary border fw-normal me-1"><i class="bi bi-tag-fill me-1"></i>Nấm da</span>
                            <span class="badge bg-light text-secondary border fw-normal me-1"><i class="bi bi-tag-fill me-1"></i>Lây nhiễm</span>
                            <span class="badge bg-light text-secondary border fw-normal"><i class="bi bi-tag-fill me-1"></i>Bệnh da liễu</span>
                        </div>
                        <p class="card-text small text-muted mb-4">
                            Bạn thấy thú cưng rụng lông từng mảng tròn, ngứa liên tục... vài ngày sau chính bạn cũng xuất hiện vết đỏ. Tìm hiểu nguyên nhân và phác đồ điều trị dứt điểm...
                        </p>
                        <a href="#" data-bs-toggle="modal" data-bs-target="#articleModal1" class="text-warning fw-bold text-decoration-none small hover-arrow">
                            Đọc thêm <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Article 2 -->
            <div class="col-md-6 col-lg-4 reveal delay-200">
                <div class="card border-0 glass-card h-100 overflow-hidden shadow-sm">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1581888227599-779811939961?q=80&w=400&auto=format&fit=crop" class="card-img-top" alt="Chó bị rụng lông" style="height: 220px; object-fit: cover;" />
                        <span class="position-absolute top-0 start-0 m-3 badge bg-warning text-dark fw-bold text-uppercase">Kinh nghiệm</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-2 mb-2 text-muted small">
                            <span><i class="bi bi-calendar3 me-1"></i> 24/05/2026</span>
                            <span>•</span>
                            <span><i class="bi bi-person-fill me-1"></i> Bác sĩ MyPetClinic</span>
                        </div>
                        <h5 class="card-title fw-bold mb-2">
                            <a href="#" data-bs-toggle="modal" data-bs-target="#articleModal2" class="text-decoration-none text-dark hover-text-warning">
                                Tại sao chó bị rụng lông và cách điều trị hiệu quả
                            </a>
                        </h5>
                        <div class="mb-3">
                            <span class="badge bg-light text-secondary border fw-normal me-1"><i class="bi bi-tag-fill me-1"></i>Rụng lông</span>
                            <span class="badge bg-light text-secondary border fw-normal me-1"><i class="bi bi-tag-fill me-1"></i>Kinh nghiệm</span>
                            <span class="badge bg-light text-secondary border fw-normal"><i class="bi bi-tag-fill me-1"></i>Chăm sóc chó</span>
                        </div>
                        <p class="card-text small text-muted mb-4">
                            Chó rụng lông là hiện tượng sinh lý bình thường nhưng rụng quá nhiều kèm theo ngứa, lở loét có thể là biểu hiện của viêm da, ghẻ Demodex hoặc dị ứng...
                        </p>
                        <a href="#" data-bs-toggle="modal" data-bs-target="#articleModal2" class="text-warning fw-bold text-decoration-none small hover-arrow">
                            Đọc thêm <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Article 3 -->
            <div class="col-md-6 col-lg-4 reveal delay-300">
                <div class="card border-0 glass-card h-100 overflow-hidden shadow-sm">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1544568100-847a948585b9?q=80&w=400&auto=format&fit=crop" class="card-img-top" alt="Chó bị táo bón" style="height: 220px; object-fit: cover;" />
                        <span class="position-absolute top-0 start-0 m-3 badge bg-info fw-bold text-uppercase">Dinh dưỡng</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-2 mb-2 text-muted small">
                            <span><i class="bi bi-calendar3 me-1"></i> 20/05/2026</span>
                            <span>•</span>
                            <span><i class="bi bi-person-fill me-1"></i> Bác sĩ MyPetClinic</span>
                        </div>
                        <h5 class="card-title fw-bold mb-2">
                            <a href="#" data-bs-toggle="modal" data-bs-target="#articleModal3" class="text-decoration-none text-dark hover-text-warning">
                                Chó bị táo bón: Biểu hiện và cách điều trị tại nhà
                            </a>
                        </h5>
                        <div class="mb-3">
                            <span class="badge bg-light text-secondary border fw-normal me-1"><i class="bi bi-tag-fill me-1"></i>Táo bón</span>
                            <span class="badge bg-light text-secondary border fw-normal me-1"><i class="bi bi-tag-fill me-1"></i>Tiêu hóa</span>
                            <span class="badge bg-light text-secondary border fw-normal"><i class="bi bi-tag-fill me-1"></i>Dinh dưỡng</span>
                        </div>
                        <p class="card-text small text-muted mb-4">
                            Táo bón khiến thú cưng rặn khó khăn, lười ăn, bụng phình to và ảnh hưởng nghiêm trọng đến sức khỏe đường ruột. Hướng dẫn cách xử lý an toàn từ bác sĩ...
                        </p>
                        <a href="#" data-bs-toggle="modal" data-bs-target="#articleModal3" class="text-warning fw-bold text-decoration-none small hover-arrow">
                            Đọc thêm <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        </div>
    </div>

    <!-- Article Modals -->
    <!-- Modal 1 -->
    <div class="modal fade" id="articleModal1" tabindex="-1" aria-labelledby="articleModalLabel1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 p-md-5 pt-0">
                    <span class="badge bg-danger fw-bold text-uppercase mb-3">Sức khỏe</span>
                    <h3 class="fw-bold mb-3" id="articleModalLabel1">Nấm da ở chó mèo có lây sang người không?</h3>
                    <div class="d-flex align-items-center gap-2 mb-4 text-muted small border-bottom pb-3">
                        <span><i class="bi bi-calendar3 me-1"></i> 25/05/2026</span>
                        <span>•</span>
                        <span><i class="bi bi-person-fill me-1"></i> Bác sĩ MyPetClinic</span>
                    </div>
                    <img src="https://images.unsplash.com/photo-1596492784531-6e6eb5ea9993?q=80&w=800&auto=format&fit=crop" class="img-fluid rounded-3 mb-4 w-100" style="max-height: 400px; object-fit: cover;" alt="Nấm da ở chó mèo" />
                    
                    <div class="article-content text-muted lh-lg">
                        <p>Nấm da (Ringworm) là một trong những căn bệnh da liễu cực kỳ phổ biến ở chó mèo, đặc biệt là trong môi trường thời tiết nóng ẩm. Triệu chứng dễ nhận biết nhất là thú cưng bị rụng lông thành từng mảng tròn, da mẩn đỏ, có vảy sừng và ngứa ngáy liên tục.</p>
                        <h5 class="fw-bold text-dark mt-4 mb-3">Nấm da có lây sang người không?</h5>
                        <p>Câu trả lời là <strong>CÓ</strong>. Nấm da là một bệnh truyền nhiễm có thể lây từ động vật sang người thông qua tiếp xúc trực tiếp hoặc gián tiếp qua đồ dùng (chăn nệm, lược chải lông).</p>
                        <h5 class="fw-bold text-dark mt-4 mb-3">Cách phòng ngừa và điều trị</h5>
                        <ul>
                            <li>Cách ly thú cưng bị bệnh khỏi trẻ em và các vật nuôi khác.</li>
                            <li>Đưa bé đến phòng khám thú y để được bác sĩ lấy mẫu xét nghiệm và kê đơn thuốc bôi/uống phù hợp.</li>
                            <li>Vệ sinh sạch sẽ không gian sống bằng dung dịch sát khuẩn chuyên dụng.</li>
                        </ul>
                        <p class="mt-4"><i>Lưu ý: Không tự ý mua thuốc bôi cho thú cưng nếu chưa có sự chỉ định của bác sĩ thú y để tránh tình trạng bệnh nặng hơn hoặc ngộ độc thuốc do thú cưng liếm phải.</i></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal 2 -->
    <div class="modal fade" id="articleModal2" tabindex="-1" aria-labelledby="articleModalLabel2" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4 p-md-5 pt-0">
                    <span class="badge bg-warning text-dark fw-bold text-uppercase mb-3">Kinh nghiệm</span>
                    <h3 class="fw-bold mb-3" id="articleModalLabel2">Tại sao chó bị rụng lông và cách điều trị hiệu quả</h3>
                    <div class="d-flex align-items-center gap-2 mb-4 text-muted small border-bottom pb-3">
                        <span><i class="bi bi-calendar3 me-1"></i> 24/05/2026</span>
                        <span>•</span>
                        <span><i class="bi bi-person-fill me-1"></i> Bác sĩ MyPetClinic</span>
                    </div>
                    <img src="https://images.unsplash.com/photo-1581888227599-779811939961?q=80&w=800&auto=format&fit=crop" class="img-fluid rounded-3 mb-4 w-100" style="max-height: 400px; object-fit: cover;" alt="Chó bị rụng lông" />
                    
                    <div class="article-content text-muted lh-lg">
                        <p>Rụng lông ở chó là một hiện tượng sinh lý bình thường diễn ra theo chu kỳ (thường là vào mùa xuân và mùa thu). Tuy nhiên, nếu lượng lông rụng quá nhiều, rụng thành từng mảng lộ cả da non, kèm theo các triệu chứng như ngứa ngáy, gãi liên tục, lở loét hoặc da có mùi hôi, thì đó có thể là dấu hiệu cảnh báo vấn đề sức khỏe.</p>
                        <h5 class="fw-bold text-dark mt-4 mb-3">Các nguyên nhân phổ biến</h5>
                        <ul>
                            <li><strong>Thiếu hụt dinh dưỡng:</strong> Chế độ ăn thiếu protein, vitamin (đặc biệt là Biotin) và khoáng chất.</li>
                            <li><strong>Nhiễm ký sinh trùng:</strong> Ve, rận, bọ chét hoặc ghẻ Demodex/Sarcoptes.</li>
                            <li><strong>Dị ứng:</strong> Dị ứng thức ăn, thời tiết, hoặc các sản phẩm sữa tắm không phù hợp.</li>
                        </ul>
                        <h5 class="fw-bold text-dark mt-4 mb-3">Giải pháp khắc phục</h5>
                        <p>Bổ sung ngay các loại thực phẩm giàu Omega 3-6 (như dầu cá, hạt lanh) vào khẩu phần ăn hàng ngày. Thường xuyên chải lông để loại bỏ lông rụng và massage kích thích nang lông phát triển. Nếu chó gãi nhiều và da ửng đỏ, hãy đặt lịch khám tại MyPetClinic để bác sĩ kiểm tra và điều trị kịp thời.</p>
                    </div>
                </div>
            </div>
        </div>
