@{
    ViewData["Title"] = "Liên Hệ - MyPetClinic";
}

<section class="py-5 bg-gold-gradient position-relative text-center">
    <div class="hero-shape-1"></div>
    <div class="container py-4">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm text-uppercase">
            <i class="bi bi-telephone-inbound me-1"></i> Kết Nối Với Chúng Tôi
        </span>
        <h1 class="display-4 fw-bold mb-3 gradient-text-gold">LIÊN HỆ & ĐẶT LỊCH</h1>
        <p class="fs-5 text-muted max-w-2xl mx-auto">
            Cơ sở chính sẵn sàng hỗ trợ thăm khám, tư vấn chăm sóc sức khỏe cho bé cưng mọi lúc bạn cần.
        </p>
    </div>
</section>

<section class="py-5 bg-white">
    <div class="container">
        <div class="row g-5">
            <!-- Left Column: Location details and Working Hours -->
            <div class="col-lg-5">
                <h3 class="fw-bold mb-4">Trụ Sở Chính</h3>
                
                <!-- Branch 1 -->
                <div class="d-flex align-items-start gap-3 mb-4">
                    <div class="bg-warning bg-opacity-25 text-warning rounded-3 p-3" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-geo-alt-fill fs-4"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1 text-dark">MyPetClinic (Trụ sở chính)</h6>
                        <p class="small text-muted mb-1">124A Xuân Thủy, Phường An Khánh, TP. Hồ Chí Minh</p>
                        <p class="small mb-0 text-warning fw-bold"><i class="bi bi-telephone-fill me-1"></i> Hotline: 0905 090 629</p>
                    </div>
                </div>

                <hr class="my-4" />

                <h4 class="fw-bold mb-3">Giờ Làm Việc</h4>
                <div class="card bg-light border-0 p-3 rounded-4 mb-4">
                    <div class="d-flex justify-content-between mb-2 small text-muted">
                        <span>Thứ 2 - Thứ 7:</span>
                        <strong class="text-dark">Sáng: 08:00 - 12:00 | Chiều: 14:00 - 19:00</strong>
                    </div>
                    <div class="d-flex justify-content-between small text-muted">
                        <span>Chủ nhật & Lễ:</span>
                        <strong class="text-dark">Sáng: 08:00 - 12:00 (Chiều nghỉ)</strong>
                    </div>
                </div>

                <h4 class="fw-bold mb-3">Bản Đồ</h4>
                <div class="rounded-4 overflow-hidden border shadow-sm" style="height: 220px;">
                    <iframe style="border: 0; width: 100%; height: 100%;" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3920.0531119583807!2d106.70744515079734!3d10.73038709231523!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f91a2a96ad1%3A0xc19a98cc93ec317e!2sPetcare+Veterinary+Hospital!5e0!3m2!1sen!2s!4v1465265330727" frameborder="0" allowfullscreen="allowfullscreen"></iframe>
                </div>
            </div>

            <!-- Right Column: Booking Form -->
            <div class="col-lg-7">
                <div class="card border-0 glass-card p-4 shadow-md">
                    <h3 class="fw-bold mb-3 text-dark">Đặt Lịch Ngay</h3>
                    <p class="text-muted small mb-4">
                        Quý khách vui lòng điền đầy đủ thông tin bên dưới để đăng ký lịch hẹn khám cho thú cưng của bạn tại MyPetClinic:
                    </p>

                    <form id="bookingFormContact" onsubmit="handleBookingContactSubmit(event)">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control input-premium rounded-3" id="contactOwnerName" required placeholder="Nguyễn Văn A" />
                                    <label for="contactOwnerName"><i class="bi bi-person me-1 text-muted"></i> Họ và tên *</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="tel" class="form-control input-premium rounded-3" id="contactPhone" required placeholder="0901234567" />
                                    <label for="contactPhone"><i class="bi bi-telephone me-1 text-muted"></i> Số điện thoại *</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control input-premium rounded-3" id="contactPetName" required placeholder="Milu" />
                                    <label for="contactPetName"><i class="bi bi-heart me-1 text-muted"></i> Tên thú cưng *</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select class="form-select input-premium rounded-3" id="contactPetType" required>
                                        <option value="Chó">Chó</option>
                                        <option value="Mèo">Mèo</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                    <label for="contactPetType"><i class="bi bi-gender-ambiguous me-1 text-muted"></i> Loại thú cưng</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select class="form-select input-premium rounded-3" id="contactService" required>
                                        <option value="Khám & Điều trị">Khám & Điều trị</option>
                                        <option value="Tiêm phòng">Tiêm phòng Vaccine</option>
                                        <option value="Spa & Grooming">Spa & Làm đẹp</option>
                                        <option value="Dịch vụ khác">Dịch vụ khác</option>
                                    </select>
                                    <label for="contactService"><i class="bi bi-journal-medical me-1 text-muted"></i> Chọn dịch vụ *</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="date" class="form-control input-premium rounded-3" id="contactDate" required />
                                    <label for="contactDate"><i class="bi bi-calendar me-1 text-muted"></i> Ngày đặt lịch *</label>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-floating">
                                    <select class="form-select input-premium rounded-3" id="contactTime" required>
                                        <option value="08:00 - 09:00">Ca sáng: 08:00 - 09:00</option>
                                        <option value="09:00 - 10:00">Ca sáng: 09:00 - 10:00</option>
                                        <option value="10:00 - 11:00">Ca sáng: 10:00 - 11:00</option>
                                        <option value="11:00 - 12:00">Ca sáng: 11:00 - 12:00</option>
                                        <option value="14:00 - 15:00">Ca chiều: 14:00 - 15:00</option>
                                        <option value="15:00 - 16:00">Ca chiều: 15:00 - 16:00</option>
                                        <option value="16:00 - 17:00">Ca chiều: 16:00 - 17:00</option>
                                        <option value="17:00 - 18:00">Ca chiều: 17:00 - 18:00</option>
                                        <option value="18:00 - 19:00">Ca chiều: 18:00 - 19:00</option>
                                    </select>
                                    <label for="contactTime"><i class="bi bi-clock me-1 text-muted"></i> Giờ hẹn mong muốn *</label>
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-floating">
                                    <textarea class="form-control input-premium rounded-3" id="contactNotes" style="height: 120px;" placeholder="Triệu chứng hoặc yêu cầu đặc biệt..."></textarea>
                                    <label for="contactNotes"><i class="bi bi-chat-left-text me-1 text-muted"></i> Triệu chứng / Ghi chú thêm</label>
                                </div>
                            </div>

                            <div class="col-md-12 text-end">
                                <button type="submit" class="btn btn-premium w-100 py-3 shadow-md mt-2">
                                    <i class="bi bi-calendar-check-fill me-1"></i> Xác Nhận Đặt Lịch Hẹn
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- FAQ Section -->
        <div class="mt-5 pt-4">
            <h3 class="fw-bold text-center mb-5">Câu Hỏi Thường Gặp (FAQs)</h3>
            <div class="row g-4 justify-content-center">
                <div class="col-md-10">
                    <div class="accordion accordion-flush" id="accordionFAQ">
                        <div class="accordion-item border-bottom py-2">
                            <h2 class="accordion-header" id="headingOne">
                                <button class="accordion-button collapsed fw-bold text-dark bg-transparent border-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                                    1. Tôi có cần đặt lịch khám trước khi đưa thú cưng tới không?
                                </button>
                            </h2>
                            <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionFAQ">
                                <div class="accordion-body text-muted small">
                                    MyPetClinic khuyến khích khách hàng đặt lịch khám trực tuyến hoặc gọi hotline trước khi đến để được ưu tiên sắp xếp bác sĩ và hạn chế thời gian chờ đợi. Tuy nhiên, chúng tôi vẫn tiếp nhận các ca khám trực tiếp trong giờ làm việc.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item border-bottom py-2">
                            <h2 class="accordion-header" id="headingTwo">
                                <button class="accordion-button collapsed fw-bold text-dark bg-transparent border-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                    2. Chi phí điều trị nội trú tại bệnh viện được tính thế nào?
                                </button>
                            </h2>
                            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionFAQ">
                                <div class="accordion-body text-muted small">
                                    Chi phí chăm sóc nội trú bao gồm phí lưu chuồng theo ngày, tiền thuốc theo phác đồ điều trị, dinh dưỡng đặc thù và công theo dõi sát sao của các điều dưỡng. Bác sĩ sẽ luôn trao đổi chi tiết và đưa ra bảng ước tính chi phí trước khi làm thủ tục nhập viện cho thú cưng.
                                </div>
                            </div>
                        </div>
                        <div class="accordion-item border-0 py-2">
                            <h2 class="accordion-header" id="headingThree">
                                <button class="accordion-button collapsed fw-bold text-dark bg-transparent border-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                    3. Bệnh viện có tiếp nhận cấp cứu ngoài giờ hành chính không?
                                </button>
                            </h2>
                            <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#accordionFAQ">
                                <div class="accordion-body text-muted small">
                                    Hiện tại, MyPetClinic hoạt động phục vụ theo khung giờ hành chính cố định được niêm yết (Thứ 2 - Thứ 7: 8h00 - 19h00; Chủ nhật: 8h00 - 12h00). Đối với các sự cố khẩn cấp phát sinh ngoài giờ làm việc trên, quý khách vui lòng liên hệ các trung tâm cấp cứu 24/7 chuyên biệt.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function handleBookingContactSubmit(event) {
            event.preventDefault();
            const ownerName = document.getElementById('contactOwnerName').value;
            const phone = document.getElementById('contactPhone').value;
            const petName = document.getElementById('contactPetName').value;
            const petType = document.getElementById('contactPetType').value;
            const service = document.getElementById('contactService').value;
            const date = document.getElementById('contactDate').value;
            const time = document.getElementById('contactTime').value;

            alert(`Đặt lịch thành công!\n\nThông tin lịch hẹn:\n- Khách hàng: ${ownerName}\n- SĐT: ${phone}\n- Thú cưng: ${petName} (${petType})\n- Dịch vụ: ${service}\n- Thời gian: ${time} ngày ${date}\n\nMyPetClinic sẽ liên hệ lại với bạn sớm nhất để xác nhận lịch hẹn.`);
            
            document.getElementById('bookingFormContact').reset();
            const today = new Date().toISOString().split('T')[0];
            const contactDate = document.getElementById('contactDate');
            if (contactDate) {
                contactDate.value = today;
            }
        }
    </script>
}
