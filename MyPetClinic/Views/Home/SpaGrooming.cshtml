@{
    ViewData["Title"] = "Dịch Vụ Spa & Thẩm Mỹ Cắt Tỉa - MyPetClinic";
}

<section class="py-5 bg-gold-gradient position-relative text-center">
    <div class="hero-shape-1"></div>
    <div class="container py-4">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm text-uppercase">
            <i class="bi bi-scissors me-1"></i> Chăm Sóc Sắc Đẹp
        </span>
        <h1 class="display-4 fw-bold mb-3 gradient-text-gold">SPA & THẨM MỸ CẮT TỈA</h1>
        <p class="fs-5 text-muted max-w-2xl mx-auto">
            Hô biến diện mạo lộng lẫy cho bé cưng với bàn tay khéo léo của các chuyên gia Grooming hàng đầu cùng thiết bị tắm sấy cao cấp.
        </p>
    </div>
</section>

<section class="py-5 bg-white">
    <div class="container">
        <!-- 7-Step Grooming Process -->
        <h3 class="fw-bold text-center mb-5">Quy Trình Spa 7 Bước Chuyên Nghiệp</h3>
        <div class="row g-4 mb-5">
            <!-- Step 1 -->
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 glass-card p-3 h-100 text-center">
                    <span class="fs-3 fw-bold text-warning mb-2">01</span>
                    <h6 class="fw-bold text-dark">Kiểm tra da & lông</h6>
                    <p class="text-muted small mb-0">Đánh giá tình trạng gàu, nấm hoặc ký sinh trùng để chọn loại dầu tắm phù hợp.</p>
                </div>
            </div>
            <!-- Step 2 -->
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 glass-card p-3 h-100 text-center">
                    <span class="fs-3 fw-bold text-warning mb-2">02</span>
                    <h6 class="fw-bold text-dark">Vệ sinh tai & Mài móng</h6>
                    <p class="text-muted small mb-0">Cắt tỉa móng chân gọn gàng, mài mịn móng tránh cào xước. Vệ sinh sạch tai bằng dung dịch chuyên dụng.</p>
                </div>
            </div>
            <!-- Step 3 -->
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 glass-card p-3 h-100 text-center">
                    <span class="fs-3 fw-bold text-warning mb-2">03</span>
                    <h6 class="fw-bold text-dark">Vắt tuyến hôi</h6>
                    <p class="text-muted small mb-0">Giúp giải phóng dịch ứ đọng ở hậu môn, loại bỏ mùi hôi đặc trưng và tránh viêm nhiễm tuyến hậu môn.</p>
                </div>
            </div>
            <!-- Step 4 -->
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 glass-card p-3 h-100 text-center">
                    <span class="fs-3 fw-bold text-warning mb-2">04</span>
                    <h6 class="fw-bold text-dark">Tắm massage 2 lần</h6>
                    <p class="text-muted small mb-0">Lần 1 làm sạch bụi bẩn, lần 2 dùng dầu dưỡng mềm mượt và lưu hương dài lâu.</p>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-5 justify-content-center">
            <!-- Step 5 -->
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 glass-card p-3 h-100 text-center">
                    <span class="fs-3 fw-bold text-warning mb-2">05</span>
                    <h6 class="fw-bold text-dark">Sấy & Đánh tơi lông</h6>
                    <p class="text-muted small mb-0">Sấy khô kết hợp chải tơi lông bằng máy sấy chuyên dụng không ồn để thú cưng không hoảng sợ.</p>
                </div>
            </div>
            <!-- Step 6 -->
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 glass-card p-3 h-100 text-center">
                    <span class="fs-3 fw-bold text-warning mb-2">06</span>
                    <h6 class="fw-bold text-dark">Cắt tỉa tạo kiểu</h6>
                    <p class="text-muted small mb-0">Groomer tay nghề cao thiết kế kiểu lông (Teddy bear, tròn, phẳng...) theo yêu cầu của chủ nuôi.</p>
                </div>
            </div>
            <!-- Step 7 -->
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 glass-card p-3 h-100 text-center">
                    <span class="fs-3 fw-bold text-warning mb-2">07</span>
                    <h6 class="fw-bold text-dark">Xịt dưỡng hoa hồng</h6>
                    <p class="text-muted small mb-0">Thoa dầu dưỡng bảo vệ lông chống xơ rối và tạo mùi hương thơm dịu nhẹ quý phái.</p>
                </div>
            </div>
        </div>

        <!-- Pricing Grid -->
        <h3 class="fw-bold text-center mb-4">Bảng Giá Dịch Vụ Spa Trọn Gói</h3>
        <p class="text-muted text-center max-w-2xl mx-auto mb-5">
            Bảng giá được tính toán dựa trên khối lượng cân nặng thực tế và độ phức tạp của bộ lông thú cưng.
        </p>
        <div class="row g-4 justify-content-center">
            <div class="col-md-8">
                <div class="card border-0 glass-card overflow-hidden shadow-sm">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-warning">
                                <tr>
                                    <th scope="col" class="ps-4">Cân nặng Thú cưng</th>
                                    <th scope="col">Gói Spa Tắm Dưỡng</th>
                                    <th scope="col" class="pe-4">Gói Spa Cắt Tỉa Tạo Kiểu</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-4"><strong>Dưới 5kg</strong></td>
                                    <td>150.000 VNĐ</td>
                                    <td class="pe-4">300.000 VNĐ</td>
                                </tr>
                                <tr>
                                    <td class="ps-4"><strong>Từ 5kg - dưới 10kg</strong></td>
                                    <td>200.000 VNĐ</td>
                                    <td class="pe-4">400.000 VNĐ</td>
                                </tr>
                                <tr>
                                    <td class="ps-4"><strong>Từ 10kg - dưới 20kg</strong></td>
                                    <td>300.000 VNĐ</td>
                                    <td class="pe-4">550.000 VNĐ</td>
                                </tr>
                                <tr>
                                    <td class="ps-4"><strong>Trên 20kg</strong></td>
                                    <td>Liên hệ trực tiếp</td>
                                    <td class="pe-4">Liên hệ trực tiếp</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Beautiful Visual Display -->
        <div class="row g-4 mt-5">
            <div class="col-md-6">
                <img src="https://images.unsplash.com/photo-1516734212186-a967f81ad0d7?q=80&w=600&auto=format&fit=crop" class="img-fluid rounded-4 shadow" alt="Dog getting bathed" />
            </div>
            <div class="col-md-6">
                <img src="https://images.unsplash.com/photo-1527526029430-319f10814151?q=80&w=600&auto=format&fit=crop" class="img-fluid rounded-4 shadow" alt="Dog getting haircut" />
            </div>
        </div>
    </div>
</section>
