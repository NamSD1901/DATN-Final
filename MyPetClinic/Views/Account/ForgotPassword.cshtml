@{
    ViewData["Title"] = "Quên mật khẩu - MyPetClinic";
}

<section class="py-5 bg-gold-gradient min-vh-100 d-flex align-items-center position-relative overflow-hidden">
    <div class="hero-shape-1"></div>
    <div class="hero-shape-2"></div>
    
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 reveal">
                <div class="card border-0 glass-card p-4 p-md-5 shadow-lg">
                    <!-- Logo / Brand Branding -->
                    <div class="text-center mb-4">
                        <a class="navbar-brand justify-content-center text-dark fs-2 mb-2 d-inline-flex text-decoration-none" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-heart-pulse-fill brand-accent"></i>
                            MyPet<span class="brand-accent">Clinic</span>
                        </a>
                        <h4 class="fw-bold text-dark mt-2">Quên Mật Khẩu</h4>
                        <p class="text-muted small">Vui lòng nhập địa chỉ email của bạn. Chúng tôi sẽ gửi một mã OTP để bạn đặt lại mật khẩu.</p>
                    </div>

                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 rounded-3 shadow-sm py-2 px-3 mb-3 small d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                <div>
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger list-unstyled mb-0 p-0" })
                                </div>
                            </div>
                        }

                        <!-- Floating Input Email -->
                        <div class="form-floating mb-4">
                            <input type="email" name="email" class="form-control input-premium rounded-3" placeholder="name@example.com" required autofocus />
                            <label><i class="bi bi-envelope me-1 text-muted"></i> Địa chỉ Email</label>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-premium w-100 py-3 shadow-md mb-3">
                            Gửi mã OTP <i class="bi bi-send ms-1 fs-5"></i>
                        </button>
                    </form>

                    <div class="text-center mt-3 small">
                        <a asp-action="Login" class="text-warning fw-bold text-decoration-none hover-text-warning"><i class="bi bi-arrow-left"></i> Quay lại đăng nhập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
