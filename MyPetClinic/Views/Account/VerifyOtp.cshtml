@{
    ViewData["Title"] = "Xác nhận OTP - MyPetClinic";
    var email = ViewBag.Email as string;
}

<section class="py-5 bg-gold-gradient min-vh-100 d-flex align-items-center position-relative overflow-hidden">
    <!-- Floating background decorative elements -->
    <div class="hero-shape-1"></div>
    <div class="hero-shape-2"></div>
    
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 reveal">
                <div class="card border-0 glass-card p-4 p-md-5 shadow-lg">
                    <!-- Logo / Brand Branding -->
                    <div class="text-center mb-4">
                        <a class="navbar-brand justify-content-center text-dark fs-2 mb-2 d-inline-flex text-decoration-none" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-heart-pulse-fill brand-accent"></i>
                            MyPet<span class="brand-accent">Clinic</span>
                        </a>
                        <h4 class="fw-bold text-dark mt-2">Xác Thực Tài Khoản</h4>
                        <p class="text-muted small">Chúng tôi đã gửi một mã OTP gồm 6 chữ số đến email <strong>@email</strong>. Vui lòng kiểm tra hộp thư của bạn.</p>
                    </div>

                    <form asp-action="VerifyOtp" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="email" value="@email" />

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 rounded-3 shadow-sm py-2 px-3 mb-3 small d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                <div>
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger list-unstyled mb-0 p-0" })
                                </div>
                            </div>
                        }

                        <!-- Floating Input OTP -->
                        <div class="form-floating mb-4">
                            <input type="text" name="otpCode" class="form-control input-premium rounded-3 text-center fs-4 letter-spacing-2" placeholder="123456" maxlength="6" required autofocus />
                            <label><i class="bi bi-key me-1 text-muted"></i> Nhập mã OTP 6 số</label>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-premium w-100 py-3 shadow-md mb-3">
                            Xác Nhận <i class="bi bi-check-circle ms-1 fs-5"></i>
                        </button>
                    </form>

                    <div class="text-center mt-3 small">
                        <span class="text-muted">Không nhận được email? </span>
                        <!-- Optionally you can implement Resend OTP link -->
                        <a href="javascript:history.back()" class="text-warning fw-bold text-decoration-none hover-text-warning">Quay lại trang Đăng ký</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
