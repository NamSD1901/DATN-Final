@model MyPetClinic.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="row justify-content-center my-5">
    <div class="col-md-8 col-lg-6">
        <!-- Premium glassmorphic registration card -->
        <div class="card border-0 shadow-lg registration-card">
            <div class="card-header border-0 bg-gradient text-white text-center py-4 rounded-top-4" style="background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%);">
                <h3 class="mb-1 fw-bold text-uppercase tracking-wide">MyPetClinic</h3>
                <p class="mb-0 text-white-50 fs-6">Đăng ký tài khoản thành viên mới</p>
            </div>
            
            <div class="card-body p-4 p-md-5 bg-white rounded-bottom-4">
                <form asp-action="Register" method="post" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <h5 class="text-secondary fw-semibold border-bottom pb-2 mb-4">
                        <i class="bi bi-person-fill me-2"></i>Thông tin bắt buộc
                    </h5>

                    <!-- Full Name Field -->
                    <div class="form-floating mb-3">
                        <input asp-for="FullName" class="form-control rounded-3 border-light-subtle shadow-sm input-premium" placeholder="Nguyễn Văn A" required />
                        <label asp-for="FullName" class="text-muted"><i class="bi bi-person me-1"></i>Họ và tên</label>
                        <span asp-validation-for="FullName" class="text-danger fs-7 mt-1 d-block"></span>
                    </div>

                    <!-- Email Field -->
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control rounded-3 border-light-subtle shadow-sm input-premium" placeholder="name@example.com" type="email" required />
                        <label asp-for="Email" class="text-muted"><i class="bi bi-envelope me-1"></i>Địa chỉ Email</label>
                        <span asp-validation-for="Email" class="text-danger fs-7 mt-1 d-block"></span>
                    </div>

                    <!-- Password Field & Confirm Password in 2 columns -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Password" class="form-control rounded-3 border-light-subtle shadow-sm input-premium" placeholder="Mật khẩu" type="password" required />
                                <label asp-for="Password" class="text-muted"><i class="bi bi-lock me-1"></i>Mật khẩu</label>
                                <span asp-validation-for="Password" class="text-danger fs-7 mt-1 d-block"></span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="ConfirmPassword" class="form-control rounded-3 border-light-subtle shadow-sm input-premium" placeholder="Xác nhận mật khẩu" type="password" required />
                                <label asp-for="ConfirmPassword" class="text-muted"><i class="bi bi-check2-circle me-1"></i>Xác nhận lại</label>
                                <span asp-validation-for="ConfirmPassword" class="text-danger fs-7 mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <h5 class="text-secondary fw-semibold border-bottom pb-2 my-4">
                        <i class="bi bi-card-list me-2"></i>Thông tin bổ sung (Demo)
                    </h5>

                    <!-- Phone and Gender -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="Phone" class="form-control rounded-3 border-light-subtle shadow-sm input-premium" placeholder="Số điện thoại" />
                                <label asp-for="Phone" class="text-muted"><i class="bi bi-telephone me-1"></i>Số điện thoại</label>
                                <span asp-validation-for="Phone" class="text-danger fs-7 mt-1 d-block"></span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <select asp-for="Gender" class="form-select rounded-3 border-light-subtle shadow-sm input-premium">
                                    <option value="">-- Chọn giới tính --</option>
                                    <option value="1">Nam</option>
                                    <option value="2">Nữ</option>
                                    <option value="0">Khác</option>
                                </select>
                                <label asp-for="Gender" class="text-muted"><i class="bi bi-gender-ambiguous me-1"></i>Giới tính</label>
                                <span asp-validation-for="Gender" class="text-danger fs-7 mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Date of Birth -->
                    <div class="form-floating mb-3">
                        <input asp-for="DateOfBirth" class="form-control rounded-3 border-light-subtle shadow-sm input-premium" type="date" />
                        <label asp-for="DateOfBirth" class="text-muted"><i class="bi bi-calendar-event me-1"></i>Ngày sinh</label>
                        <span asp-validation-for="DateOfBirth" class="text-danger fs-7 mt-1 d-block"></span>
                    </div>

                    <!-- Address -->
                    <div class="form-floating mb-4">
                        <textarea asp-for="Address" class="form-control rounded-3 border-light-subtle shadow-sm input-premium" placeholder="Địa chỉ liên hệ" style="height: 100px;"></textarea>
                        <label asp-for="Address" class="text-muted"><i class="bi bi-geo-alt me-1"></i>Địa chỉ hiện tại</label>
                        <span asp-validation-for="Address" class="text-danger fs-7 mt-1 d-block"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-premium w-100 py-3 rounded-3 fw-bold text-uppercase fs-6 shadow-md transition-all">
                        Đăng Ký Thành Viên <i class="bi bi-arrow-right-circle ms-2"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
}

<style>
    /* Styling definitions for a highly premium, modern interface */
    .registration-card {
        border-radius: 1rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        overflow: hidden;
    }
    .registration-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.15) !important;
    }
    .input-premium {
        border: 1px solid #e2e8f0;
        transition: all 0.25s ease-in-out;
    }
    .input-premium:focus {
        border-color: #4f46e5;
        box-shadow: 0 0 0 0.25rem rgba(79, 70, 229, 0.15) !important;
    }
    .btn-premium {
        background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%);
        color: white;
        border: none;
        letter-spacing: 0.5px;
    }
    .btn-premium:hover {
        background: linear-gradient(135deg, #4338ca 0%, #0891b2 100%);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(79, 70, 229, 0.3) !important;
    }
    .btn-premium:active {
        transform: translateY(1px);
    }
    .fs-7 {
        font-size: 0.85rem;
    }
    .transition-all {
        transition: all 0.2s ease-in-out;
    }
</style>
