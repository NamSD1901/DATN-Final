@model MyPetClinic.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản - MyPetClinic";
}

<section class="py-5 bg-gold-gradient min-vh-100 d-flex align-items-center position-relative overflow-hidden">
    <!-- Floating background decorative elements -->
    <div class="hero-shape-1"></div>
    <div class="hero-shape-2"></div>
    
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6 reveal">
                <div class="card border-0 glass-card p-4 p-md-5 shadow-lg">
                    <!-- Logo / Brand Branding -->
                    <div class="text-center mb-4">
                        <a class="navbar-brand justify-content-center text-dark fs-2 mb-2 d-inline-flex text-decoration-none" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-heart-pulse-fill brand-accent"></i>
                            MyPet<span class="brand-accent">Clinic</span>
                        </a>
                        <h4 class="fw-bold text-dark mt-2">Đăng Ký Thành Viên</h4>
                        <p class="text-muted small">Hãy tạo tài khoản để trải nghiệm các dịch vụ chăm sóc thú cưng đẳng cấp</p>
                    </div>

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                        {
                            <div class="alert alert-danger border-0 rounded-3 shadow-sm py-2 px-3 mb-3 small d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                <div>
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger list-unstyled mb-0 p-0" })
                                </div>
                            </div>
                        }

                        <div class="row g-3">
                            <!-- Họ và tên -->
                            <div class="col-md-12">
                                <div class="form-floating">
                                    <input asp-for="FullName" class="form-control input-premium rounded-3" placeholder="Nguyễn Văn A" required />
                                    <label asp-for="FullName"><i class="bi bi-person me-1 text-muted"></i> Họ và tên</label>
                                    <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Email" class="form-control input-premium rounded-3" placeholder="name@example.com" required />
                                    <label asp-for="Email"><i class="bi bi-envelope me-1 text-muted"></i> Địa chỉ Email</label>
                                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- Số điện thoại -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Phone" class="form-control input-premium rounded-3" placeholder="0912345678" required />
                                    <label asp-for="Phone"><i class="bi bi-telephone me-1 text-muted"></i> Số điện thoại</label>
                                    <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- Mật khẩu -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Password" class="form-control input-premium rounded-3" placeholder="Mật khẩu" required />
                                    <label asp-for="Password"><i class="bi bi-lock me-1 text-muted"></i> Mật khẩu</label>
                                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- Xác nhận mật khẩu -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ConfirmPassword" class="form-control input-premium rounded-3" placeholder="Xác nhận mật khẩu" required />
                                    <label asp-for="ConfirmPassword"><i class="bi bi-shield-lock me-1 text-muted"></i> Xác nhận mật khẩu</label>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-premium w-100 py-3 shadow-md mt-4 mb-3">
                            Đăng Ký Thành Viên <i class="bi bi-person-plus-fill ms-1 fs-5"></i>
                        </button>

                        <!-- Go to login link -->
                        <div class="text-center mt-3 small">
                            <span class="text-muted">Bạn đã có tài khoản thành viên? </span>
                            <a asp-action="Login" class="text-warning fw-bold text-decoration-none hover-text-warning">Đăng nhập ngay</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
