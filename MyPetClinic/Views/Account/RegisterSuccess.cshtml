@{
    ViewData["Title"] = "Đăng Ký Thành Công - MyPetClinic";
}

<section class="py-5 bg-gold-gradient min-vh-100 d-flex align-items-center position-relative overflow-hidden">
    <!-- Floating background decorative elements -->
    <div class="hero-shape-1"></div>
    <div class="hero-shape-2"></div>
    
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 reveal">
                <div class="card border-0 glass-card p-4 p-md-5 shadow-lg text-center">
                    
                    <!-- Celebration Icon -->
                    <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-25 text-warning rounded-circle mb-4 shadow-sm" style="width: 100px; height: 100px;">
                        <i class="bi bi-party-fill fs-1"></i>
                    </div>

                    <!-- Welcome Brand Logo -->
                    <h2 class="fw-bold text-dark mb-3">Đăng Ký Thành Công!</h2>
                    
                    <p class="text-muted mb-4 fs-6">
                        Chúc mừng bạn đã trở thành thành viên của bệnh viện thú y <strong class="text-dark">MyPetClinic</strong>! 
                        Bây giờ bạn đã có thể đăng nhập tài khoản để đặt lịch khám và nhận cẩm nang sức khỏe dành riêng cho thú cưng của mình.
                    </p>

                    <!-- CTA Buttons -->
                    <div class="d-grid gap-2">
                        <a asp-action="Login" class="btn btn-premium py-3 shadow-md">
                            Đăng Nhập Ngay <i class="bi bi-box-arrow-in-right ms-2 fs-5"></i>
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-premium-outline py-3">
                            <i class="bi bi-house-door me-2"></i> Quay về Trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
